# Copy to .env next to compose.yaml. Every variable here is required.

# Image tag. Pin a release, never `latest`, so a `pull` cannot upgrade you by accident.
SPHERICON_VERSION=latest

# Public origin of the Instance, used in links and emails.
SPHERICON_APP_URL=https://mail.example.com

# openssl rand -hex 32 (hex only: it is placed in a connection URL)
POSTGRES_PASSWORD=

# openssl rand -hex 32
SPHERICON_JWT_SECRET=

# docker run --rm ghcr.io/getsphericon/sphericon:latest genkey
# Back it up with the database: stored provider credentials cannot be read without it.
SPHERICON_ENCRYPTION_KEY=
