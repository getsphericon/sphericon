# Secrets — never bake env files into an image. config.Load merges .env files
# before AutomaticEnv, so a stray .env would silently override real env vars.
.env
.env.*

.git
.github

# Dependencies / build caches (provided via bind-mount or installed in-image)
node_modules
# Workspace packages' links too: `COPY . .` runs after the install and would replace them.
**/node_modules
.pnpm-store
tmp
npm-cache
.npm

# Large committed dev binary
seed

# Build outputs (rebuilt inside the image)
dist
dist-release
bin
packages/*/dist
internal/server/assets/spa

# Editor / OS
.idea
.vscode
.DS_Store
*.log
