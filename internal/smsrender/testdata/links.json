{
  "about": "The links of an SMS text and how the counter counts them once each is a short tracked link (ADR 0083), read by both counters (internal/smsrender and src/utils/smsParts.ts). A text is its pieces, each a string repeated a number of times; links are the spans found as links, in order; linkLength is the length of the short link each one becomes, 0 for a text whose links are not tracked. The figures are worked out by hand.",
  "cases": [
    {
      "name": "a link counts as its short link",
      "text": [["Shop https://shop.example/a/very/long/path?x=1&y=2 now", 1]],
      "links": ["https://shop.example/a/very/long/path?x=1&y=2"],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 39,
      "parts": 1
    },
    {
      "name": "every link counts as a short link",
      "text": [["A https://a.example/one B http://b.example/two", 1]],
      "links": ["https://a.example/one", "http://b.example/two"],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 65,
      "parts": 1
    },
    {
      "name": "punctuation after a link stays text",
      "text": [["See https://shop.example/sale. Or (https://shop.example/x)!", 1]],
      "links": ["https://shop.example/sale", "https://shop.example/x"],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 72,
      "parts": 1
    },
    {
      "name": "a parenthesis that opens inside a link closes inside it",
      "text": [["Read https://wiki.example/Foo_(bar) now", 1]],
      "links": ["https://wiki.example/Foo_(bar)"],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 39,
      "parts": 1
    },
    {
      "name": "a merge tag inside a link belongs to the link",
      "text": [["Hi https://shop.example/?id={{ contact.id }}&s=sms ok", 1]],
      "links": ["https://shop.example/?id={{ contact.id }}&s=sms"],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 36,
      "parts": 1
    },
    {
      "name": "a link outside GSM-7 leaves the text GSM-7 once short",
      "text": [["Go https://shop.example/путь", 1]],
      "links": ["https://shop.example/путь"],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 33,
      "parts": 1
    },
    {
      "name": "what only starts like a link, or has no scheme, is no link",
      "text": [["Visit https:// or shop.example today", 1]],
      "links": [],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 36,
      "parts": 1
    },
    {
      "name": "an untracked link counts as written",
      "text": [["Shop https://shop.example/x", 1]],
      "links": ["https://shop.example/x"],
      "linkLength": 0,
      "encoding": "GSM-7",
      "characters": 27,
      "parts": 1
    },
    {
      "name": "a long link written takes two parts and its short link one",
      "text": [
        ["a", 120],
        [" https://shop.example/", 1],
        ["p", 80]
      ],
      "links": [
        "https://shop.example/pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
      ],
      "linkLength": 30,
      "encoding": "GSM-7",
      "characters": 151,
      "parts": 1
    },
    {
      "name": "the same long link untracked takes two parts",
      "text": [
        ["a", 120],
        [" https://shop.example/", 1],
        ["p", 80]
      ],
      "links": [
        "https://shop.example/pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
      ],
      "linkLength": 0,
      "encoding": "GSM-7",
      "characters": 222,
      "parts": 2
    }
  ]
}
