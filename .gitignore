build/Release

# Dependency directories
node_modules
jspm_packages
.pnpm-store

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# 0x
profile-*

# mac files
.DS_Store

# env files — local overrides are gitignored, shared envs are not
.env
.env.local
.env.*.local

