.cache/
.lycheecache

# build artifacts
dist
packages/*/dist
# built SPA copied into the Go embed tree by `mise run build:spa` (release only)
internal/server/assets/spa/
# release changelog copied into the Go embed tree by `mise run build:changelog`
internal/changelog/CHANGELOG.md

# compiled Go binaries / goreleaser output
bin/
cover.out
/dist-release/

# personal mise overrides
.mise.local.toml
mise.local.toml
.mise-skills.json
.mise-packslip/
.claude/skills/hk-configure
.claude/skills/hk-debug
.claude/skills/pitchfork

