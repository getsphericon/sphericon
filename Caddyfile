# Dev edge. Every address, host and port comes from the mise environment (.mise.toml):
# the primary checkout serves sphericon.localhost on :443, a linked worktree serves its own
# <dir>.sphericon.localhost on its own port, so several stacks run side by side.
{
	# Caddy's admin API (`caddy trust` reads the root certificate from it) and the HTTP
	# listener behind the http -> https redirect are one per instance: 2019 and 80 in the
	# primary checkout, offset ports in a linked worktree (.mise.toml).
	admin {$CADDY_ADMIN}
	http_port {$CADDY_HTTP_PORT}

	# Human-readable dev output: plain console lines instead of JSON, warnings and errors only
	# (the startup chatter is noise; the backend logs every request itself).
	log {
		format console
		level WARN
	}
}

# A backend that is down, still building or refused to start (a bad config) leaves Caddy with
# nothing to proxy to: instead of an empty 502, answer with a problem the SPA shows as it is. A
# heredoc, because the command in the detail is set in backticks, the way the backend sets one.
(backend_down) {
	handle_errors {
		@backendDown expression {err.status_code} in [502, 503, 504]
		header @backendDown Content-Type application/problem+json
		respond @backendDown <<JSON
			\{"status":502,"title":"Bad Gateway","detail":"The backend is not answering on port {$BACKEND_PORT}. It may have refused to start (a bad config) or still be building: run `mise daemons logs backend` to see why."\}
			JSON 502
	}
}

{$APP_HOST}:{$CADDY_PORT} {
	tls internal
	import backend_down

	# API → Go backend
	@api path /site* /staff* /collect* /auth* /avatar* /api* /.well-known/* /oauth/authorize /oauth/token /oauth/register
	reverse_proxy @api localhost:{$BACKEND_PORT}

	# MCP: the SDK refuses a non-loopback Host on a loopback listener (DNS rebinding guard), and
	# the dev backend is one, so /mcp reaches it with the upstream's own host. The Bearer token
	# is what authenticates; nothing on this path reads the original Host.
	@mcp path /mcp*
	reverse_proxy @mcp localhost:{$BACKEND_PORT} {
		header_up Host {upstream_hostport}
	}

	# Everything else → Vite dev server (includes HMR websocket upgrade)
	reverse_proxy localhost:{$FRONTEND_PORT}
}

{$API_HOST}:{$CADDY_PORT} {
	tls internal
	import backend_down

	# Subdomain root maps to the binary's /api path prefix (RudderStack-style edge).
	# The Go binary stays path-based (/api); the public subdomain lives only here.
	rewrite * /api{uri}
	reverse_proxy localhost:{$BACKEND_PORT}
}

# Tracking ingestion on its own host: the tracker's paths already start with /collect, so no rewrite.
{$COLLECT_HOST}:{$CADDY_PORT} {
	tls internal
	import backend_down
	reverse_proxy localhost:{$BACKEND_PORT}
}

# The demo storefront: a customer site on its own origin, so its tracker runs cross-origin like
# a real one (packages/storefront).
{$DEMO_HOST}:{$CADDY_PORT} {
	tls internal
	reverse_proxy localhost:{$DEMO_PORT}
}

# Mailpit's web UI (captured outbound email), on a host of its own instead of a bare port.
{$MAIL_HOST}:{$CADDY_PORT} {
	tls internal
	reverse_proxy localhost:{$MAILPIT_PORT}
}
