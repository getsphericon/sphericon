// Actor kinds of an Audit entry. A scope built from a secret rather than a login carries
// ActorIngest, which is never audited.
const (
	ActorUser     = "user"
	ActorAPIToken = "api_token"
	ActorStaff = "staff"
	// ActorService is a Service credential (ADR 0026): a machine identity of the platform,
	// named in the log, which every customer-facing read shows as ActorStaff.
	ActorService = "service"
	ActorSystem  = "system"
	ActorIngest   = "ingest"
)

// Actor is who performs the writes of a scope. Name is a display snapshot (a User's
// name) so an entry stays readable after the actor is gone.
type Actor struct {
	Kind string `json:"kind"`
	ID   string `json:"id,omitempty"`
	Name string `json:"name,omitempty"`
}

// AuditChange is one change of an audited entity, as the scoped client reports it.
type AuditChange struct {
	Actor      Actor
	Action     string // <entity>.<verb>
	TargetType string
	TargetID   string
	TargetName string
	// Diff maps a changed field to {"from": v, "to": v}; a sensitive field maps to
	// "changed" and never carries a value.
	Diff map[string]any
}

// AuditPublisher publishes an AuditChange inside the transaction the scope is bound to.
type AuditPublisher interface {
	PublishAudit(ctx context.Context, workspaceID int64, change AuditChange) error
}

// AuditOpener runs fn inside a transaction over the Workspace of s. fn receives a scope
// bound to that transaction (with the same actor and opener, and the publisher of the
// transaction); the transaction commits iff fn returns nil.
type AuditOpener interface {
	WithinAuditTx(ctx context.Context, s *Scoped, fn func(ts *Scoped) error) error
}

var (
	// ErrAuditUnavailable: the scope has an actor that is audited but no way to open the
	// transaction that carries the entry. Set both with Scoped.As.
	ErrAuditUnavailable = errors.New("ent: audited actor without a transaction opener")
	// ErrAuditUpsert: an upsert of an audited entity cannot tell an insert from an update,
	// so only DoNothing is allowed (an insert is audited, a conflict writes nothing).
	ErrAuditUpsert = errors.New("ent: upsert of an audited entity must use DoNothing")
)

// As returns the scope with the actor of its writes and the opener of the transactions
// they run in (the events bus). The ingest actor needs no opener.
func (s *Scoped) As(actor Actor, opener AuditOpener) *Scoped {
	c := *s
	c.actor, c.opener = actor, opener
	return &c
}

// Actor returns the actor of the scope's writes.
func (s *Scoped) Actor() Actor { return s.actor }

// InTx returns a scope over the same Workspace, actor and opener, bound to the
// transaction client tx and to the publisher of that transaction: an audited write
// through it joins the transaction instead of opening one.
func (s *Scoped) InTx(tx *Client, pub AuditPublisher) *Scoped {
	return &Scoped{c: tx, ws: s.ws, actor: s.actor, opener: s.opener, pub: pub}
}

// auditing reports whether writes of audited entities through the scope are recorded.
func (s *Scoped) auditing() bool {
	return s.actor.Kind != "" && s.actor.Kind != ActorIngest
}

// audited runs fn in the transaction that carries the entries: the one the scope is
// bound to (joined, never nested) or a new one.
func (s *Scoped) audited(ctx context.Context, fn func(ts *Scoped) error) error {
	if s.pub != nil {
		return fn(s)
	}
	if s.opener == nil {
		return ErrAuditUnavailable
	}
	return s.opener.WithinAuditTx(ctx, s, fn)
}

// record publishes the change in the scope's transaction.
func (s *Scoped) record(ctx context.Context, change AuditChange) error {
	change.Actor = s.actor
	return s.pub.PublishAudit(ctx, s.ws, change)
}

// AuditDiff computes the diff of an audited entity's fields. A nil before is a create
// (every field is "to"), a nil after a delete (every field is "from"); otherwise
// only the fields that differ appear. A field in sensitive records only that it changed.
func AuditDiff(before, after map[string]any, sensitive map[string]bool) map[string]any {
	diff := map[string]any{}
	names := before
	if names == nil {
		names = after
	}
	for name := range names {
		b, a := before[name], after[name]
		if before != nil && after != nil && reflect.DeepEqual(b, a) {
			continue
		}
		switch {
		case sensitive[name]:
			diff[name] = "changed"
		case before == nil:
			diff[name] = map[string]any{"to": a}
		case after == nil:
			diff[name] = map[string]any{"from": b}
		default:
			diff[name] = map[string]any{"from": b, "to": a}
		}
	}
	return diff
}

