// auditKeep makes an update's diff carry the field even when it did not change.
func auditKeep(diff, before, after map[string]any, name string) {
	if before == nil || after == nil {
		return
	}
	if _, ok := diff[name]; !ok {
		diff[name] = map[string]any{"from": before[name], "to": after[name]}
	}
}

// auditURLName reduces a URL to scheme, host and path for an entry's name snapshot: a
// query string, a fragment and userinfo may carry a secret. An unparsable value yields
// no name at all rather than a raw copy.
func auditURLName(raw string) string {
	u, err := url.Parse(raw)
	if err != nil || u.Host == "" {
		return ""
	}
	return (&url.URL{Scheme: u.Scheme, Host: u.Host, Path: u.Path}).String()
}

// derefAudit returns the value a pointer field points at (nil for a nil pointer), so a
// nillable field diffs like a plain one.
func derefAudit(v any) any {
	rv := reflect.ValueOf(v)
	if rv.Kind() == reflect.Pointer {
		if rv.IsNil() {
			return nil
		}
		return rv.Elem().Interface()
	}
	return v
}
