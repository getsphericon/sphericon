{{/*
The manifest of kinds: every entity, its table and the kinds ent/schema gives it (internal/entgen
classifies them by the markers of their mixins, ent/schema/kinds.go). internal/infra/devdb reads the
Workspace-owned tables from it, internal/app/entclient the types with a revision, and the registry
of the scoped client (ScopedEntity) carries each Workspace-owned entity's.
*/}}
{{ define "kinds" }}
{{ template "header" $ }}

// Kind is what ent/schema makes of an entity (internal/entgen).
type Kind struct {
	// Table is the entity's table.
	Table string
	// WorkspaceOwned: it takes WorkspaceMixin and is reached through the scoped client (ADR 0017).
	WorkspaceOwned bool
	// Archivable: it takes ArchiveMixin (ADR 0100).
	Archivable bool
	// Discardable: it takes DiscardMixin (ADR 0049, ADR 0100).
	Discardable bool
	// Versioned: it takes VersionedMixin, a Versioned definition (ADR 0065).
	Versioned bool
	// Revised: it takes RevisionMixin and has a revision (ADR 0119).
	Revised bool
	// Singleton: a Workspace holds at most one of its rows (a unique index on its workspace_id).
	Singleton bool
}

// Kinds is the Kind of every entity, by its schema name.
var Kinds = map[string]Kind{
{{- range $e := entities $ }}
	"{{ $e.Name }}": {Table: "{{ $e.Table }}"
		{{- if $e.WorkspaceOwned }}, WorkspaceOwned: true{{ end }}
		{{- if $e.Archivable }}, Archivable: true{{ end }}
		{{- if $e.Discardable }}, Discardable: true{{ end }}
		{{- if $e.Versioned }}, Versioned: true{{ end }}
		{{- if $e.Revised }}, Revised: true{{ end }}
		{{- if $e.Singleton }}, Singleton: true{{ end }}},
{{- end }}
}
{{ end }}
