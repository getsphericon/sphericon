{{/*
The storage half of a Versioned definition (ADR 0065, GLOSSARY: Versioned definition). Every
entity that embeds VersionedMixin (entc.go finds its mixed-in live_version_id) gets
<N>Pointers on its scoped wrapper: the operations on its live and draft pointers and on its
state, written through the scoped, audited builders. internal/domain/content/versioneddefinition, the lifecycle shared by
every Versioned definition, is written against VersionedStore and is their one caller; nothing
is hand-written per entity.
*/}}
{{ define "scoped_versioned" }}
{{ template "header" $ }}

{{ $nodes := versionedNodes $ }}
import (
	"context"
	"errors"
	"time"

	{{- range $n := $nodes }}
	"{{ $.Config.Package }}/{{ $n.Package }}"
	{{- $V := versionOf $n }}
	"{{ $.Config.Package }}/{{ $V.Package }}"
	{{- end }}
)

// ErrNotDiscardable: the lifecycle discarded a Versioned definition that is archived, never
// discarded (ADR 0100).
var ErrNotDiscardable = errors.New("ent: an archivable Versioned definition is archived, never discarded")

// ErrNotArchivable: the lifecycle archived or unarchived a Versioned definition that is discarded,
// never archived (ADR 0100).
var ErrNotArchivable = errors.New("ent: a discardable Versioned definition is discarded, never archived")

// VersionPosition is the state and pointers written together by a Versioned definition's machine.
// A zero pointer means that there is no version in that position.
type VersionPosition struct {
    Active    bool
    Archived  bool
    Discarded bool
    LiveID    int64
    DraftID   int64
}

// VersionState is a loaded position and its versions. UpdatedAt fences every write, including
// an edit that rewrites the same draft, so a stale reader cannot accept an unchanged status.
type VersionState[O, V any] struct {
    VersionPosition
    Row         *O
    ID          int64
    UpdatedAt   time.Time
    ActivatedAt *time.Time
    Live        *V
    Draft       *V
}

// VersionedStore is the generated, scoped and audited storage of a Versioned definition.
// Its one state writer compares the full position and revision before changing anything.
type VersionedStore[O, V any] interface {
    Load(ctx context.Context, id int64) (*O, error)
    Read(ctx context.Context, id int64) (VersionState[O, V], error)
    CompareAndSwap(ctx context.Context, before VersionState[O, V], after VersionPosition, at time.Time) (bool, error)
    Newest(ctx context.Context, id int64) (int, error)
    DeleteVersion(ctx context.Context, id, versionID int64) error
}

{{ range $n := $nodes }}
{{ $N := $n.Name }}
{{ $P := $n.Package }}
{{ $V := versionOf $n }}
{{ $VP := $V.Package }}
{{ $of := versionOwnerField $n }}
{{ $R := archivable $n }}

var _ VersionedStore[{{ $N }}, {{ $V.Name }}] = (*{{ $N }}Pointers)(nil)

// VersionState returns the {{ $N }}'s state and the versions loaded on its edges.
func ({{ $n.Receiver }} *{{ $N }}) VersionState() VersionState[{{ $N }}, {{ $V.Name }}] {
    st := VersionState[{{ $N }}, {{ $V.Name }}]{
        Row: {{ $n.Receiver }},
        ID: {{ $n.Receiver }}.ID,
        UpdatedAt: {{ $n.Receiver }}.UpdatedAt,
        ActivatedAt: {{ $n.Receiver }}.ActivatedAt,
        Live: {{ $n.Receiver }}.Edges.LiveVersion,
        Draft: {{ $n.Receiver }}.Edges.DraftVersion,
    }
    st.Active = {{ $n.Receiver }}.Status == {{ $P }}.StatusActive
    {{- if $R }}
    st.Archived = {{ $n.Receiver }}.ArchivedAt != nil
    {{- else }}
    st.Discarded = {{ $n.Receiver }}.DiscardedAt != nil
    {{- end }}
    if {{ $n.Receiver }}.LiveVersionID != nil {
        st.LiveID = *{{ $n.Receiver }}.LiveVersionID
    }
    if {{ $n.Receiver }}.DraftVersionID != nil {
        st.DraftID = *{{ $n.Receiver }}.DraftVersionID
    }
    return st
}

// {{ $N }}Pointers are the operations on the live and draft pointers and the state of the
// Workspace's {{ $N }} rows, a Versioned definition. internal/domain/content/versioneddefinition is their one caller.
type {{ $N }}Pointers struct {
	t    *{{ $N }}Scoped
	with []func(*{{ $V.Name }}Query)
}

// Pointers returns the pointer operations; with is applied to every version a read loads (its
// child rows).
func (t *{{ $N }}Scoped) Pointers(with ...func(*{{ $V.Name }}Query)) *{{ $N }}Pointers {
	return &{{ $N }}Pointers{t: t, with: with}
}

func (p *{{ $N }}Pointers) query(id int64) *{{ $N }}Query {
	return p.t.QueryWith{{ if $R }}Archived{{ else }}Discarded{{ end }}().Where({{ $P }}.ID(id)).WithLiveVersion(p.with...).WithDraftVersion(p.with...)
}

// Load returns the {{ $N }} with the id, archived or not, with its live version and draft.
func (p *{{ $N }}Pointers) Load(ctx context.Context, id int64) (*{{ $N }}, error) {
	return p.query(id).Only(ctx)
}

// Read loads the position without taking a row lock; CompareAndSwap decides a race.
func (p *{{ $N }}Pointers) Read(ctx context.Context, id int64) (VersionState[{{ $N }}, {{ $V.Name }}], error) {
    row, err := p.Load(ctx, id)
    if err != nil {
        return VersionState[{{ $N }}, {{ $V.Name }}]{}, err
    }
    return row.VersionState(), nil
}

// CompareAndSwap writes status, pointers and deletion markers in one conditional update.
// Matching UpdatedAt also fences an edit of an existing draft whose pointers do not change.
func (p *{{ $N }}Pointers) CompareAndSwap(ctx context.Context, before VersionState[{{ $N }}, {{ $V.Name }}], after VersionPosition, at time.Time) (bool, error) {
    {{- if $R }}
    if after.Discarded {
        return false, ErrNotDiscardable
    }
    {{- else }}
    if after.Archived {
        return false, ErrNotArchivable
    }
    {{- end }}
    u := p.t.UpdateOneID(before.ID).Where({{ $P }}.UpdatedAtEQ(before.UpdatedAt))
    if before.Active {
        u.Where({{ $P }}.StatusEQ({{ $P }}.StatusActive))
    } else {
        u.Where({{ $P }}.StatusEQ({{ $P }}.StatusInactive))
    }
    if before.LiveID == 0 {
        u.Where({{ $P }}.LiveVersionIDIsNil())
    } else {
        u.Where({{ $P }}.LiveVersionIDEQ(before.LiveID))
    }
    if before.DraftID == 0 {
        u.Where({{ $P }}.DraftVersionIDIsNil())
    } else {
        u.Where({{ $P }}.DraftVersionIDEQ(before.DraftID))
    }
    {{- if $R }}
    if before.Archived {
        u.Where({{ $P }}.ArchivedAtNotNil())
    } else {
        u.Where({{ $P }}.ArchivedAtIsNil())
    }
    if after.Archived && !before.Archived {
        u.SetArchivedAt(at)
    } else if !after.Archived {
        u.ClearArchivedAt()
    }
    {{- else }}
    if before.Discarded {
        u.Where({{ $P }}.DiscardedAtNotNil())
    } else {
        u.Where({{ $P }}.DiscardedAtIsNil())
    }
    if after.Discarded && !before.Discarded {
        u.SetDiscardedAt(at)
    }
    {{- end }}
    if after.Active {
        u.SetStatus({{ $P }}.StatusActive)
        if !before.Active {
            u.SetActivatedAt(at)
        }
    } else {
        u.SetStatus({{ $P }}.StatusInactive)
    }
    if after.LiveID == 0 {
        u.ClearLiveVersionID()
    } else {
        u.SetLiveVersionID(after.LiveID)
    }
    if after.DraftID == 0 {
        u.ClearDraftVersionID()
    } else {
        u.SetDraftVersionID(after.DraftID)
    }
    verb := "update"
    {{- if $R }}
    if after.Archived && !before.Archived {
        verb = "archive"
    } else if before.Archived && !after.Archived {
        verb = "unarchive"
    }
    {{- else }}
    if after.Discarded && !before.Discarded {
        verb = "discard"
    }
    {{- end }}
    _, err := u.save(ctx, verb)
    if IsNotFound(err) {
        return false, nil
    }
    return err == nil, err
}

// Newest returns the number of the {{ $N }}'s newest version, 0 when it has none.
func (p *{{ $N }}Pointers) Newest(ctx context.Context, id int64) (int, error) {
	newest, err := p.t.s.{{ $V.Name }}().Query().
		Where({{ $VP }}.{{ $of.StructField }}(id)).
		Order(Desc({{ $VP }}.FieldVersion)).
		First(ctx)
	if IsNotFound(err) {
		return 0, nil
	}
	if err != nil {
		return 0, err
	}
	return newest.Version, nil
}

// DeleteVersion removes the {{ $N }}'s version with the versionID.
func (p *{{ $N }}Pointers) DeleteVersion(ctx context.Context, id, versionID int64) error {
	return p.t.s.{{ $V.Name }}().DeleteOneID(versionID).Where({{ $VP }}.{{ $of.StructField }}(id)).Exec(ctx)
}

{{ end }}
{{ end }}
