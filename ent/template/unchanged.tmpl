{{/*
A write that changes nothing writes nothing (ADR 0119). For every type with a revision but a Versioned
definition (whose compare-and-swap names its revision with the rest of its position), Unchanged tells
internal/app/entclient's Revision hook whether an update of one row would write only what the row
already holds, reading the row by its id and the update's own predicates: a no-op over a stale
revision, or over a row a predicate fences, is no no-op, and the write goes on to miss.
*/}}
{{ define "unchanged" }}
{{ template "header" $ }}

import (
	"context"
	"encoding/json"
	"reflect"
	"slices"
	"time"

	"{{ $.Config.Package }}/schema"
	{{- range $n := unchangedNodes }}
	"{{ $.Config.Package }}/{{ $n.Package }}"
	{{- end }}
)

// Unchanged reports whether m, an update of one row of a type with a revision, sets every column it
// names to the value the row holds, and returns that row when it does: the write is then not made,
// so neither the revision nor updated_at moves. The row is read by its id and m's predicates, so an
// update they exclude is never unchanged. In doubt it is a change: an edge m adds, removes or
// clears; a number it adds to; a column it clears that cannot be told from its zero value; an update
// that names no column but updated_at (a touch); and a sealed column, whose ciphertext is new each
// time. A JSON column compares by value (jsonb reorders keys), a time at microseconds (what Postgres
// keeps). Any other mutation is not unchanged.
func Unchanged(ctx context.Context, m Mutation) (Value, bool, error) {
	switch m := m.(type) {
	{{- range $n := unchangedNodes }}
	case *{{ $n.Name }}Mutation:
		row, unchanged, err := m.unchanged(ctx)
		if !unchanged || err != nil {
			return nil, false, err
		}
		return row, true, nil
	{{- end }}
	}
	return nil, false, nil
}

// sameJSON reports whether a and b hold the same JSON value, whatever the order of their keys. A
// value that does not round-trip through JSON is never the same: in doubt, a change.
func sameJSON(a, b any) bool {
	x, okA := jsonValue(a)
	y, okB := jsonValue(b)
	return okA && okB && reflect.DeepEqual(x, y)
}

// jsonValue is v as the generic value its JSON decodes to, false when v does not round-trip.
func jsonValue(v any) (any, bool) {
	raw, err := json.Marshal(v)
	if err != nil {
		return nil, false
	}
	var decoded any
	err = json.Unmarshal(raw, &decoded)
	return decoded, err == nil
}

// sameTime reports whether a and b are the same moment at the microseconds Postgres keeps.
func sameTime(a, b time.Time) bool {
	return a.Truncate(time.Microsecond).Equal(b.Truncate(time.Microsecond))
}

// revisionNoise are the columns an update writes whatever it changes: updated_at, which its default
// sets, and the revision, which the hook moves.
func revisionNoise(column string) bool {
	return column == schema.UpdatedColumn || column == schema.RevisionColumn
}

{{ range $n := unchangedNodes }}
{{- $N := $n.Name }}
{{- $P := $n.Package }}

// unchanged reports whether m sets every column of the {{ $N }} it names to what the row holds, and
// returns the row read by its id and m's predicates when it does.
func (m *{{ $N }}Mutation) unchanged(ctx context.Context) (*{{ $N }}, bool, error) {
	id, ok := m.ID()
	if !ok || !m.Op().Is(OpUpdateOne) {
		return nil, false, nil
	}
	// An edge that carries a column of the row is compared as that column.
	for _, e := range slices.Concat(m.AddedEdges(), m.RemovedEdges(), m.ClearedEdges()) {
		switch e {
		{{- range $e := $n.Edges }}{{ if $e.Field }}
		case "{{ $e.Name }}":
		{{- end }}{{ end }}
		default:
			return nil, false, nil
		}
	}
	{{- range $f := $n.MutableFields }}
	{{- if $f.SupportsMutationAdd }}
	if v, ok := m.{{ $f.MutationAdded }}(); ok && v != 0 {
		return nil, false, nil
	}
	{{- end }}
	{{- if $f.SupportsMutationAppend }}
	if v, ok := m.{{ $f.MutationAppended }}(); ok && len(v) > 0 {
		return nil, false, nil
	}
	{{- end }}
	{{- end }}
	// An update that names no column but the noise is a touch: a write of what an editor shows.
	written := slices.Concat(m.Fields(), m.ClearedFields())
	if !slices.ContainsFunc(written, func(c string) bool { return !revisionNoise(c) }) {
		return nil, false, nil
	}
	row, err := m.Client().{{ $N }}.Query().Where({{ $P }}.ID(id)).Where(m.predicates...).Only(ctx)
	if IsNotFound(err) {
		return nil, false, nil
	}
	if err != nil {
		return nil, false, err
	}
	{{- range $f := $n.MutableFields }}
	{{- if not (revisionNoiseField $f) }}
	{{- $row := print "row." $f.StructField }}
	{{- if $f.NillableValue }}{{ $row = print "*row." $f.StructField }}{{ end }}
	if v, ok := m.{{ $f.MutationGet }}(); ok {
		{{- if $f.NillableValue }}
		if row.{{ $f.StructField }} == nil {
			return nil, false, nil
		}
		{{- end }}
		{{- if $f.IsJSON }}
		if !sameJSON(v, {{ $row }}) {
		{{- else if $f.IsTime }}
		if !sameTime(v, {{ $row }}) {
		{{- else }}
		if !reflect.DeepEqual(v, {{ $row }}) {
		{{- end }}
			return nil, false, nil
		}
	}
	{{- if $f.Optional }}
	if m.{{ $f.StructField }}Cleared() {
		{{- if $f.NillableValue }}
		if row.{{ $f.StructField }} != nil {
			return nil, false, nil
		}
		{{- else }}
		return nil, false, nil
		{{- end }}
	}
	{{- end }}
	{{- end }}
	{{- end }}
	return row, true, nil
}
{{ end }}
{{ end }}
