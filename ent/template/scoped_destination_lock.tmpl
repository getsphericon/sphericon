{{/*
The scope of the Destination locks (ADR 0137, ADR 0178): DestinationLocked stands for the
transaction-scoped advisory locks of the Destinations a claim is written for, so the writer of a claim
and its Frequency cap count cannot be called without them. The bus (internal/infra/events) is the one
caller of LockDestinations, first in its transaction (forbidigo).
*/}}
{{ define "scoped_destination_lock" }}
{{ template "header" $ }}

import "context"

// DestinationLocked is the Workspace-scoped client of a transaction that holds the locks of the
// Destinations a message is claimed for (ADR 0178): each one a Frequency cap holds, and none where
// no cap applies, so the code has one path. Only LockDestinations makes one, and only the events bus
// calls it, inside WithinDestinationLockTx. It reads and writes as its Scoped does; the writer of a
// claim and its count rows takes it (the Destination lock section of
// docs/architecture/lifecycles.md).
type DestinationLocked struct {
	*lockedScope
}

// The scope that holds the locks belongs to its Workspace, as the scope does.
const (
	TypeOf_DestinationLocked        = TypeOther
	EntityOf_DestinationLocked      = "Workspace"
	RoleOf_DestinationLocked_Scope  = RoleNone
	RoleOf_Scoped_LockDestinations  = RoleNone
)

// Scope returns the transaction's scope, for a call that needs no lock of its own (the locks stay
// held to the end of the transaction either way).
func (l *DestinationLocked) Scope() *Scoped { return l.lockedScope }

// LockDestinations runs lock, which takes the transaction-scoped advisory locks of the Destinations
// on tx, the client of the transaction s is bound to, and returns the scope that stands for them once
// they are held. The locks last as long as that transaction, so s is bound to one: the events bus,
// its one caller, calls it first in its own and supplies lock (internal/infra/postgres.LockTx).
func (s *Scoped) LockDestinations(ctx context.Context, lock func(ctx context.Context, tx *Client, workspaceID int64) error) (*DestinationLocked, error) {
	if err := lock(ctx, s.c, s.ws); err != nil {
		return nil, err
	}
	return &DestinationLocked{lockedScope: s}, nil
}
