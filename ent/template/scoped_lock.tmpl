{{/*
The scope of the Workspace lock (ADR 0099, ADR 0108): WorkspaceLocked stands for the Workspace's
transaction-scoped advisory lock, so a signature that takes one cannot be called without it. The bus
(internal/infra/events) is the one caller of LockWorkspace, first in its transaction (forbidigo).
*/}}
{{ define "scoped_lock" }}
{{ template "header" $ }}

import "context"

// lockedScope is the scope a WorkspaceLocked embeds: the alias promotes every method of Scoped and
// keeps the field unexported, so no other package builds a WorkspaceLocked around a scope.
type lockedScope = Scoped

// WorkspaceLocked is the Workspace-scoped client of a transaction that holds the Workspace's lock
// (ADR 0099, ADR 0108). Only LockWorkspace makes one, and only the events bus calls it, inside
// WithinWorkspaceLockTx. It reads and writes as its Scoped does. What needs the lock takes it: the
// list is the Workspace lock section of docs/architecture/lifecycles.md.
type WorkspaceLocked struct {
	*lockedScope
}

// The scope that holds the lock belongs to its Workspace, as the scope does.
const (
	TypeOf_WorkspaceLocked       = TypeOther
	EntityOf_WorkspaceLocked     = "Workspace"
	RoleOf_WorkspaceLocked_Scope = RoleNone
	RoleOf_Scoped_LockWorkspace  = RoleNone
)

// Scope returns the transaction's scope, for a call that needs no lock of its own (the lock stays
// held to the end of the transaction either way).
func (l *WorkspaceLocked) Scope() *Scoped { return l.lockedScope }

// LockWorkspace runs lock, which takes the Workspace's transaction-scoped advisory lock on tx, the
// client of the transaction s is bound to, and returns the scope that stands for the lock once it
// is held. The lock lasts as long as that transaction, so s is bound to one: the events bus, its one
// caller, calls it first in its own and supplies lock (internal/infra/postgres.LockTx).
func (s *Scoped) LockWorkspace(ctx context.Context, lock func(ctx context.Context, tx *Client, workspaceID int64) error) (*WorkspaceLocked, error) {
	if err := lock(ctx, s.c, s.ws); err != nil {
		return nil, err
	}
	return &WorkspaceLocked{lockedScope: s}, nil
}
