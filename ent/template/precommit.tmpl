{{/*
The work a transaction does right before it commits: usages.Hook counts the Contacts peak there, so
the advisory lock that count takes is held only from the commit on, after every write of the
transaction took its row locks, and never while it waits for a row lock another transaction holds.
*/}}
{{ define "precommit" }}
{{ template "header" $ }}

import "context"

// PreCommit is work a transaction does once, right before it commits.
type PreCommit interface {
	Run(ctx context.Context) error
}

// PreCommitter is implemented by a TxBound driver whose transaction runs PreCommit work before it
// commits (the events bus's).
type PreCommitter interface {
	// BeforeCommit returns the work registered under key, registering what mk makes when there is
	// none yet.
	BeforeCommit(key any, mk func() PreCommit) PreCommit
}

const (
	TypeOf_PreCommit                  = TypeOther
	EntityOf_PreCommit                = ""
	RoleOf_PreCommit_Run              = RoleNone
	TypeOf_PreCommitter               = TypeOther
	EntityOf_PreCommitter             = ""
	RoleOf_PreCommitter_BeforeCommit  = RoleNone
	RoleOf_Client_BeforeCommit        = RoleNone
)

// BeforeCommit returns the work the client's transaction runs right before it commits under key,
// registering what mk makes when there is none yet, so a transaction that changes many rows does
// the work once. ok is false for a client whose transaction runs no such work: one on the pool,
// ent's own Tx, a test's go-txdb connection. The caller then does the work at once.
func (c *Client) BeforeCommit(key any, mk func() PreCommit) (_ PreCommit, ok bool) {
	d, ok := c.driver.(PreCommitter)
	if !ok {
		return nil, false
	}
	return d.BeforeCommit(key, mk), true
}
