{{/*
The savepoint of a write that may be refused (ADR 0106): internal/infra/db.Constraints.Write runs
the write through it, so a unique violation it reads as a refusal leaves the caller's transaction
usable. A violation aborts the Postgres transaction it happens in; rolled back to a savepoint, only
the write is undone. A client on the pool runs the write as it is: a statement outside a
transaction aborts nothing, and the pool may serve a savepoint and the write on two connections.
*/}}
{{ define "savepoint" }}
{{ template "header" $ }}

import (
	"context"
	"errors"
)

// TxBound is implemented by a driver bound to a transaction that another layer opened and owns
// (the events bus's): a client over it runs in that transaction, whose Tx does not begin a new one.
type TxBound interface {
	TxBound()
}

// savepoint is the name of the savepoint a write runs under. ROLLBACK TO and RELEASE name the most
// recent savepoint of that name, so a nested one is safe.
const savepoint = "refusable"

// inTx reports whether the client runs in a transaction: ent's own, or one a TxBound driver holds.
func (c *config) inTx() bool {
	if _, ok := c.driver.(*txDriver); ok {
		return true
	}
	_, ok := c.driver.(TxBound)
	return ok
}

// Savepoint runs fn under a savepoint of the transaction the client runs in: an error of fn rolls
// back fn's writes only, and the transaction stays usable. A client on the pool runs fn as it is.
// fn writes through this client, or a scope over it.
func (c *Client) Savepoint(ctx context.Context, fn func() error) error {
	if !c.inTx() {
		return fn()
	}
	// raw sql: ent has no savepoint.
	if _, err := c.ExecContext(ctx, "SAVEPOINT "+savepoint); err != nil {
		return err
	}
	if err := fn(); err != nil {
		// raw sql: ent has no savepoint.
		if _, rerr := c.ExecContext(ctx, "ROLLBACK TO SAVEPOINT "+savepoint); rerr != nil {
			return errors.Join(err, rerr)
		}
		// raw sql: ent has no savepoint.
		if _, rerr := c.ExecContext(ctx, "RELEASE SAVEPOINT "+savepoint); rerr != nil {
			return errors.Join(err, rerr)
		}
		return err
	}
	// raw sql: ent has no savepoint.
	_, err := c.ExecContext(ctx, "RELEASE SAVEPOINT "+savepoint)
	return err
}

// Savepoint is Client.Savepoint on the client the scope writes through.
func (s *Scoped) Savepoint(ctx context.Context, fn func() error) error {
	return s.c.Savepoint(ctx, fn)
}
