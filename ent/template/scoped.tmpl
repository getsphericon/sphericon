// {{ $N }}ScopedCreate creates a {{ $N }} of one Workspace. It has no way to name a Workspace: it
// keeps what its setters set and builds the ent create, in its Workspace, on the client the create
// runs on.
type {{ $N }}ScopedCreate struct {
	s   *Scoped
	set []func(*{{ $N }}Create)
}

// Create starts a {{ $N }} in the Workspace.
func (t *{{ $N }}Scoped) Create() *{{ $N }}ScopedCreate {
	return &{{ $N }}ScopedCreate{s: t.s}
}

// build makes the ent create on the client of s, in its Workspace.
func (x *{{ $N }}ScopedCreate) build(s *Scoped) *{{ $N }}Create {
	b := s.c.{{ $N }}.Create().SetWorkspaceID(s.ws)
	for _, set := range x.set {
		set(b)
	}
	return b
}

