	{{ template "helper/scopedsetters" . }}
{{ end }}

const (
	TypeOf_{{ $N }}ScopedCreate                   = TypeScopedCreate
	EntityOf_{{ $N }}ScopedCreate                 = "{{ $N }}"
	RoleOf_{{ $N }}ScopedCreate_Save              = RoleStep
	RoleOf_{{ $N }}ScopedCreate_Exec              = RoleStep
	RoleOf_{{ $N }}ScopedCreate_OnConflictColumns = RoleStart
	RoleOf_{{ $N }}ScopedCreate_OnConflictColumnsWhere = RoleStart
)

// Save verifies the references against the Workspace, then creates the {{ $N }}.
func (x *{{ $N }}ScopedCreate) Save(ctx context.Context) (*{{ $N }}, error) {
	var created *{{ $N }}
	err := x.s.write{{ $N }}(ctx, "{{ verb $n "create" }}", nil, false, func(s *Scoped) ([]int64, error) {
		b := x.build(s)
		if err := s.check{{ $N }}(ctx, b.Mutation()); err != nil {
			return nil, err
		}
		var err error
		if created, err = b.Save(ctx); err != nil {
			return nil, err
		}
		{{- if $A }}
		return []int64{created.ID}, nil
		{{- else }}
		return nil, nil
		{{- end }}
	})
	if err != nil {
		return nil, err
	}
	return created, nil
}

// Exec is like Save, discarding the entity.
func (x *{{ $N }}ScopedCreate) Exec(ctx context.Context) error {
	_, err := x.Save(ctx)
	return err
}

// ---------------------------------------------------------------- create bulk

// {{ $N }}ScopedCreateBulk creates several {{ $N }} entities of one Workspace at once.
type {{ $N }}ScopedCreateBulk struct {
	s  *Scoped
	xs []*{{ $N }}ScopedCreate
}

// CreateBulk batches creates started on this Workspace.
func (t *{{ $N }}Scoped) CreateBulk(xs ...*{{ $N }}ScopedCreate) *{{ $N }}ScopedCreateBulk {
	return &{{ $N }}ScopedCreateBulk{s: t.s, xs: xs}
}

// refuseForeign refuses a create started on another Workspace's scope.
func (b *{{ $N }}ScopedCreateBulk) refuseForeign() error {
	for _, x := range b.xs {
		if x.s.ws != b.s.ws {
			return fmt.Errorf("{{ $N }}: builder of another scope: %w", ErrNotInWorkspace)
		}
	}
	return nil
}

// build makes the ent bulk create on the client of s, every create of it in the Workspace, and
// verifies the references of all of them, one query per reference rather than one per row.
func (b *{{ $N }}ScopedCreateBulk) build(ctx context.Context, s *Scoped) (*{{ $N }}CreateBulk, error) {
	builders := make([]*{{ $N }}Create, len(b.xs))
	ms := make([]*{{ $N }}Mutation, len(b.xs))
	for i, x := range b.xs {
		builders[i] = x.build(s)
		ms[i] = builders[i].Mutation()
	}
	if err := s.check{{ $N }}(ctx, ms...); err != nil {
		return nil, err
	}
	return s.c.{{ $N }}.CreateBulk(builders...), nil
}

// Save verifies every builder's references, then creates the {{ $N }} entities.
func (b *{{ $N }}ScopedCreateBulk) Save(ctx context.Context) ([]*{{ $N }}, error) {
	if err := b.refuseForeign(); err != nil {
		return nil, err
	}
	var created []*{{ $N }}
	err := b.s.write{{ $N }}(ctx, "{{ verb $n "create" }}", nil, false, func(s *Scoped) ([]int64, error) {
		raw, err := b.build(ctx, s)
		if err != nil {
			return nil, err
		}
		if created, err = raw.Save(ctx); err != nil {
			return nil, err
		}
		{{- if $A }}
		ids := make([]int64, len(created))
		for i, row := range created {
			ids[i] = row.ID
		}
		return ids, nil
		{{- else }}
		return nil, nil
		{{- end }}
	})
	if err != nil {
		return nil, err
	}
	return created, nil
}

// Exec is like Save, discarding the entities.
func (b *{{ $N }}ScopedCreateBulk) Exec(ctx context.Context) error {
	_, err := b.Save(ctx)
	return err
}

const (
	TypeOf_{{ $N }}ScopedCreateBulk                   = TypeScopedCreate
	EntityOf_{{ $N }}ScopedCreateBulk                 = "{{ $N }}"
	RoleOf_{{ $N }}ScopedCreateBulk_Save              = RoleStep
	RoleOf_{{ $N }}ScopedCreateBulk_Exec              = RoleStep
	RoleOf_{{ $N }}ScopedCreateBulk_OnConflictColumns = RoleStart
)

