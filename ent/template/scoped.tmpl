// conflictOptions confines the DO UPDATE part to rows of the Workspace.
// target, when not nil, is the predicate of a partial unique index the conflict is inferred from.
func (t *{{ $N }}Scoped) conflictOptions(columns []string, target *sql.Predicate) []sql.ConflictOption {
	opts := []sql.ConflictOption{
		sql.ConflictColumns(columns...),
		sql.UpdateWhere(sql.EQ({{ $P }}.FieldWorkspaceID, t.s.ws)),
	}
	if target != nil {
		opts = append(opts, sql.ConflictWhere(target))
	}
	return opts
}

// {{ $N }}ScopedUpsertOne is the "upsert" of one {{ $N }}: the create it was started on, which a setter
// called later still changes, and what to do on a conflict.
type {{ $N }}ScopedUpsertOne struct {
	x        *{{ $N }}ScopedCreate
	conflict []sql.ConflictOption
	set      []func(*{{ $N }}UpsertOne)
	// doNothing: the conflict action is DO NOTHING (the only upsert an audited entity allows).
	doNothing bool
}

const (
	TypeOf_{{ $N }}ScopedUpsertOne                 = TypeScopedUpsert
	EntityOf_{{ $N }}ScopedUpsertOne               = "{{ $N }}"
	RoleOf_{{ $N }}ScopedUpsertOne_UpdateNewValues = RoleStep
	RoleOf_{{ $N }}ScopedUpsertOne_Ignore          = RoleStep
	RoleOf_{{ $N }}ScopedUpsertOne_DoNothing       = RoleStep
	RoleOf_{{ $N }}ScopedUpsertOne_Update          = RoleStep
	RoleOf_{{ $N }}ScopedUpsertOne_Exec            = RoleStep
	{{- if $n.HasOneFieldID }}
	RoleOf_{{ $N }}ScopedUpsertOne_ID              = RoleStep
	{{- end }}
)

// OnConflictColumns configures the columns as conflict target. A conflicting row of
// another Workspace is never updated.
func (x *{{ $N }}ScopedCreate) OnConflictColumns(columns ...string) *{{ $N }}ScopedUpsertOne {
	return x.OnConflictColumnsWhere(nil, columns...)
}

// OnConflictColumnsWhere is OnConflictColumns for a partial unique index: target is the
// index's predicate, which Postgres needs to infer the index from the columns.
func (x *{{ $N }}ScopedCreate) OnConflictColumnsWhere(target *sql.Predicate, columns ...string) *{{ $N }}ScopedUpsertOne {
	return &{{ $N }}ScopedUpsertOne{x: x, conflict: (&{{ $N }}Scoped{s: x.s}).conflictOptions(columns, target)}
}

// UpdateNewValues updates the mutable fields using the new values set on create.
func (u *{{ $N }}ScopedUpsertOne) UpdateNewValues() *{{ $N }}ScopedUpsertOne {
	u.set = append(u.set, func(r *{{ $N }}UpsertOne) { r.UpdateNewValues() })
	return u
}

// Ignore sets each column to itself in case of conflict.
func (u *{{ $N }}ScopedUpsertOne) Ignore() *{{ $N }}ScopedUpsertOne {
	u.set = append(u.set, func(r *{{ $N }}UpsertOne) { r.Ignore() })
	return u
}

// DoNothing configures the conflict_action to `DO NOTHING`.
func (u *{{ $N }}ScopedUpsertOne) DoNothing() *{{ $N }}ScopedUpsertOne {
	u.set = append(u.set, func(r *{{ $N }}UpsertOne) { r.DoNothing() })
	u.doNothing = true
	return u
}

// Update overrides fields' `UPDATE` values.
func (u *{{ $N }}ScopedUpsertOne) Update(set func(*{{ $N }}ScopedUpsert)) *{{ $N }}ScopedUpsertOne {
	u.set = append(u.set, func(r *{{ $N }}UpsertOne) {
		r.Update(func(s *{{ $N }}Upsert) { set(&{{ $N }}ScopedUpsert{u: s.UpdateSet}) })
	})
	return u
}

// build makes the ent upsert on the client of s and verifies the create's references.
func (u *{{ $N }}ScopedUpsertOne) build(ctx context.Context, s *Scoped) (*{{ $N }}UpsertOne, error) {
	b := u.x.build(s)
	if err := s.check{{ $N }}(ctx, b.Mutation()); err != nil {
		return nil, err
	}
	r := b.OnConflict(u.conflict...)
	for _, set := range u.set {
		set(r)
	}
	return r, nil
}

// Exec verifies the references, then executes the upsert.
func (u *{{ $N }}ScopedUpsertOne) Exec(ctx context.Context) error {
	{{- if $n.HasOneFieldID }}
	_, err := u.ID(ctx)
	return err
}

// ID is like Exec, returning the inserted or updated id.{{ if $A }} An audited upsert must be DO NOTHING:
// an insert is a create, a conflict (sql.ErrNoRows) writes nothing and records nothing.{{ end }}
func (u *{{ $N }}ScopedUpsertOne) ID(ctx context.Context) (int64, error) {
	{{- if $A }}
	if u.x.s.auditing() && !u.doNothing {
		return 0, ErrAuditUpsert
	}
	{{- end }}
	var id int64
	err := u.x.s.write{{ $N }}(ctx, "{{ verb $n "create" }}", nil, false, func(s *Scoped) ([]int64, error) {
		r, err := u.build(ctx, s)
		if err != nil {
			return nil, err
		}
		if id, err = r.ID(ctx); err != nil {
			return nil, err
		}
		return []int64{id}, nil
	})
	if err != nil {
		return 0, err
	}
	return id, nil
	{{- else }}
	return u.x.s.write{{ $N }}(ctx, "{{ verb $n "create" }}", nil, false, func(s *Scoped) ([]int64, error) {
		r, err := u.build(ctx, s)
		if err != nil {
			return nil, err
		}
		return nil, r.Exec(ctx)
	})
	{{- end }}
}

// {{ $N }}ScopedUpsertBulk is the "upsert" of several {{ $N }} entities.
type {{ $N }}ScopedUpsertBulk struct {
	b       *{{ $N }}ScopedCreateBulk
	t       *{{ $N }}Scoped
	columns []string
	set     []func(*{{ $N }}UpsertBulk)
}

const (
	TypeOf_{{ $N }}ScopedUpsertBulk                 = TypeScopedUpsert
	EntityOf_{{ $N }}ScopedUpsertBulk               = "{{ $N }}"
	RoleOf_{{ $N }}ScopedUpsertBulk_UpdateNewValues = RoleStep
	RoleOf_{{ $N }}ScopedUpsertBulk_Ignore          = RoleStep
	RoleOf_{{ $N }}ScopedUpsertBulk_DoNothing       = RoleStep
	RoleOf_{{ $N }}ScopedUpsertBulk_Update          = RoleStep
	RoleOf_{{ $N }}ScopedUpsertBulk_Exec            = RoleStep
)

// OnConflictColumns configures the columns as conflict target. A conflicting row of
// another Workspace is never updated.
func (b *{{ $N }}ScopedCreateBulk) OnConflictColumns(columns ...string) *{{ $N }}ScopedUpsertBulk {
	return &{{ $N }}ScopedUpsertBulk{b: b, t: &{{ $N }}Scoped{s: b.s}, columns: columns}
}

// UpdateNewValues updates the mutable fields using the new values set on create.
func (u *{{ $N }}ScopedUpsertBulk) UpdateNewValues() *{{ $N }}ScopedUpsertBulk {
	u.set = append(u.set, func(r *{{ $N }}UpsertBulk) { r.UpdateNewValues() })
	return u
}

// Ignore sets each column to itself in case of conflict.
func (u *{{ $N }}ScopedUpsertBulk) Ignore() *{{ $N }}ScopedUpsertBulk {
	u.set = append(u.set, func(r *{{ $N }}UpsertBulk) { r.Ignore() })
	return u
}

// DoNothing configures the conflict_action to `DO NOTHING`.
func (u *{{ $N }}ScopedUpsertBulk) DoNothing() *{{ $N }}ScopedUpsertBulk {
	u.set = append(u.set, func(r *{{ $N }}UpsertBulk) { r.DoNothing() })
	return u
}

// Update overrides fields' `UPDATE` values.
func (u *{{ $N }}ScopedUpsertBulk) Update(set func(*{{ $N }}ScopedUpsert)) *{{ $N }}ScopedUpsertBulk {
	u.set = append(u.set, func(r *{{ $N }}UpsertBulk) {
		r.Update(func(s *{{ $N }}Upsert) { set(&{{ $N }}ScopedUpsert{u: s.UpdateSet}) })
	})
	return u
}

// Exec verifies every builder's references, then executes the upsert.{{ if $A }} An audited entity has
// no bulk upsert: it cannot tell an insert from an update.{{ end }}
func (u *{{ $N }}ScopedUpsertBulk) Exec(ctx context.Context) error {
	{{- if $A }}
	if u.b.s.auditing() {
		return ErrAuditUpsert
	}
	{{- end }}
	if err := u.b.refuseForeign(); err != nil {
		return err
	}
	return u.b.s.write{{ $N }}(ctx, "{{ verb $n "create" }}", nil, false, func(s *Scoped) ([]int64, error) {
		raw, err := u.b.build(ctx, s)
		if err != nil {
			return nil, err
		}
		r := raw.OnConflict(u.t.conflictOptions(u.columns, nil)...)
		for _, set := range u.set {
			set(r)
		}
		return nil, r.Exec(ctx)
	})
}

