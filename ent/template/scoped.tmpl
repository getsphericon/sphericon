// Save verifies the references against the Workspace, then creates the {{ $N }}.
func (x *{{ $N }}ScopedCreate) Save(ctx context.Context) (*{{ $N }}, error) {
	if err := x.check(ctx); err != nil {
		return nil, err
	}
	{{- if $A }}
	if x.s.auditing() {
		var created *{{ $N }}
		err := x.s.audited(ctx, func(ts *Scoped) error {
			x.b.auditRebind(ts.c)
			var err error
			if created, err = x.b.Save(ctx); err != nil {
				return err
			}
			return ts.record(ctx, auditChange{{ $N }}("create", nil, created))
		})
		return created, err
	}
	{{- end }}
	return x.b.Save(ctx)
}

// Exec is like Save, discarding the entity.
func (x *{{ $N }}ScopedCreate) Exec(ctx context.Context) error {
	_, err := x.Save(ctx)
	return err
}

// ---------------------------------------------------------------- create bulk

// {{ $N }}ScopedCreateBulk creates several {{ $N }} entities of one Workspace at once.
type {{ $N }}ScopedCreateBulk struct {
	s  *Scoped
	xs []*{{ $N }}ScopedCreate
}

// CreateBulk batches creates started on this Workspace.
func (t *{{ $N }}Scoped) CreateBulk(xs ...*{{ $N }}ScopedCreate) *{{ $N }}ScopedCreateBulk {
	return &{{ $N }}ScopedCreateBulk{s: t.s, xs: xs}
}

func (b *{{ $N }}ScopedCreateBulk) raw(ctx context.Context) (*{{ $N }}CreateBulk, error) {
	builders := make([]*{{ $N }}Create, len(b.xs))
	for i, x := range b.xs {
		if x.s.ws != b.s.ws {
			return nil, fmt.Errorf("{{ $N }}: builder of another scope: %w", ErrNotInWorkspace)
		}
		if err := x.check(ctx); err != nil {
			return nil, err
		}
		builders[i] = x.b
	}
	return b.s.c.{{ $N }}.CreateBulk(builders...), nil
}

// Save verifies every builder's references, then creates the {{ $N }} entities.
func (b *{{ $N }}ScopedCreateBulk) Save(ctx context.Context) ([]*{{ $N }}, error) {
	raw, err := b.raw(ctx)
	if err != nil {
		return nil, err
	}
	{{- if $A }}
	if b.s.auditing() {
		var created []*{{ $N }}
		err := b.s.audited(ctx, func(ts *Scoped) error {
			raw.auditRebind(ts.c)
			var err error
			if created, err = raw.Save(ctx); err != nil {
				return err
			}
			for _, row := range created {
				if err := ts.record(ctx, auditChange{{ $N }}("create", nil, row)); err != nil {
					return err
				}
			}
			return nil
		})
		return created, err
	}
	{{- end }}
	return raw.Save(ctx)
}

// Exec is like Save, discarding the entities.
func (b *{{ $N }}ScopedCreateBulk) Exec(ctx context.Context) error {
	_, err := b.Save(ctx)
	return err
}

