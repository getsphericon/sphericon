// {{ $N }}ScopedDeleteOne deletes one {{ $N }}: it keeps the row's id and its fences, and builds the
// ent delete on the client the delete runs on.
type {{ $N }}ScopedDeleteOne struct {
	s     *Scoped
	id    int64
	where []predicate.{{ $N }}
}

// {{ $Del }}OneID {{ if $Aside }}physically removes{{ else }}deletes{{ end }} the {{ $N }} with the id; a row of another Workspace is not found.
func (t *{{ $N }}Scoped) {{ $Del }}OneID(id int64) *{{ $N }}ScopedDeleteOne {
	return &{{ $N }}ScopedDeleteOne{s: t.s, id: id}
}

// Where appends predicates the row must also match (fencing).
func (x *{{ $N }}ScopedDeleteOne) Where(ps ...predicate.{{ $N }}) *{{ $N }}ScopedDeleteOne {
	x.where = append(x.where, ps...)
	return x
}

const (
	TypeOf_{{ $N }}ScopedDeleteOne      = TypeScopedDelete
	EntityOf_{{ $N }}ScopedDeleteOne    = "{{ $N }}"
	RoleOf_{{ $N }}ScopedDeleteOne_Where = RoleStep
	RoleOf_{{ $N }}ScopedDeleteOne_Exec  = RoleStep
)

// Exec deletes the row; a missing row is a NotFoundError.
func (x *{{ $N }}ScopedDeleteOne) Exec(ctx context.Context) error {
	where := append([]predicate.{{ $N }}{ {{ $P }}.WorkspaceID(x.s.ws)}, x.where...)
	return x.s.write{{ $N }}(ctx, "{{ verb $n "delete" }}", append([]predicate.{{ $N }}{ {{ $P }}.ID(x.id)}, where...), false, func(s *Scoped) ([]int64, error) {
		return nil, s.c.{{ $N }}.DeleteOneID(x.id).Where(where...).Exec(ctx)
	})
}

