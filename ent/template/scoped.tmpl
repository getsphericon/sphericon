// write{{ $N }} runs a write of {{ $N }} rows: run builds it on the client of the scope it is
// given and executes it, and reaches no other client. {{ if $A }}Through an audited scope (Scoped.As)
// that scope is bound to the transaction that carries the write's Audit entries (ADR 0022), which it
// joins or opens: the rows where matches are read before the write, then the same rows and the ones
// run reports it created after it, and verb is recorded for each of them whose audited fields
// changed, or for each of them when keepUnchanged (a Versioned definition's move, whose edit of a
// draft changes only the version rows, which are not audited). Through any other scope{{ else }}The
// entity is not audited, so{{ end }} run gets the scope itself.
func (s *Scoped) write{{ $N }}(ctx context.Context, verb string, where []predicate.{{ $N }}, keepUnchanged bool, run func(s *Scoped) ([]int64, error)) error {
	{{- if $A }}
	if s.auditing() {
		return s.audited(ctx, func(ts *Scoped) error {
			var before []*{{ $N }}
			if where != nil {
				var err error
				if before, err = ts.c.{{ $N }}.Query().Where(where...).All(ctx); err != nil {
					return err
				}
			}
			created, err := run(ts)
			if err != nil {
				return err
			}
			ids := make([]int64, 0, len(before)+len(created))
			beforeByID := make(map[int64]*{{ $N }}, len(before))
			for _, row := range before {
				ids = append(ids, row.ID)
				beforeByID[row.ID] = row
			}
			ids = append(ids, created...)
			after, err := ts.c.{{ $N }}.Query().Where({{ $P }}.IDIn(ids...)).All(ctx)
			if err != nil {
				return err
			}
			afterByID := make(map[int64]*{{ $N }}, len(after))
			for _, row := range after {
				afterByID[row.ID] = row
			}
			for _, id := range ids {
				if beforeByID[id] == nil && afterByID[id] == nil {
					continue
				}
				if change, changed := auditChange{{ $N }}(verb, beforeByID[id], afterByID[id]); changed || keepUnchanged {
					if err := ts.record(ctx, change); err != nil {
						return err
					}
				}
			}
			return nil
		})
	}
	{{- else }}
	_, _, _ = verb, where, keepUnchanged
	{{- end }}
	_, err := run(s)
	return err
}

// check{{ $N }} verifies every reference the mutations set against the Workspace of s, one query per
// reference for all of them.
func (s *Scoped) check{{ $N }}(ctx context.Context, ms ...*{{ $N }}Mutation) error {
	{{- range $e := scopedEdges $n }}
	{
		var ids []int64
		for _, m := range ms {
			ids = append(ids, m.{{ $e.StructField }}IDs()...)
		}
		if err := s.verify{{ $e.Type.Name }}(ctx, ids); err != nil {
			return fmt.Errorf("{{ $e.Name }}: %w", err)
		}
	}
	{{- end }}
	{{- range $r := scopedFieldRefs $n }}
	{
		var ids []int64
		for _, m := range ms {
			if v, ok := m.{{ $r.Field.MutationGet }}(); ok {
				ids = append(ids, v)
			}
		}
		if err := s.verify{{ $r.Target.Name }}(ctx, ids); err != nil {
			return fmt.Errorf("{{ $r.Field.Name }}: %w", err)
		}
	}
	{{- end }}
	return nil
}
{{ if $R }}
// Archive stamps archived_at, at `at`, on the kept {{ $N }} with the id (ps fence it further); a row of
// another Workspace, an already archived row or one a predicate excludes is not found.
func (t *{{ $N }}Scoped) Archive(ctx context.Context, id int64, at time.Time, ps ...predicate.{{ $N }}) error {
	where := append([]predicate.{{ $N }}{ {{ $P }}.ID(id), {{ $P }}.WorkspaceID(t.s.ws), {{ $P }}.ArchivedAtIsNil()}, ps...)
	return t.setArchived(ctx, id, where, "{{ verb $n "archive" }}", func(u *{{ $N }}UpdateOne) { u.SetArchivedAt(at) })
}

// Unarchive clears archived_at on the {{ $N }} with the id. Unarchiving a kept row changes
// nothing; only a row that does not exist in the Workspace is not found.
func (t *{{ $N }}Scoped) Unarchive(ctx context.Context, id int64) error {
	where := []predicate.{{ $N }}{ {{ $P }}.ID(id), {{ $P }}.WorkspaceID(t.s.ws), {{ $P }}.ArchivedAtNotNil()}
	err := t.setArchived(ctx, id, where, "{{ verb $n "unarchive" }}", func(u *{{ $N }}UpdateOne) { u.ClearArchivedAt() })
	if !IsNotFound(err) {
		return err
	}
	_, err = t.Get(ctx, id)
	return err
}

func (t *{{ $N }}Scoped) setArchived(ctx context.Context, id int64, where []predicate.{{ $N }}, verb string, set func(*{{ $N }}UpdateOne)) error {
	return t.s.write{{ $N }}(ctx, verb, where, false, func(s *Scoped) ([]int64, error) {
		u := s.c.{{ $N }}.UpdateOneID(id).Where(where...)
		set(u)
		_, err := u.Save(ctx)
		return nil, err
	})
}
{{ end }}{{ if $D }}
// Discard stamps discarded_at, at `at`, on the kept {{ $N }} with the id (ps fence it further){{ with discardClears $n }}
// and, in the same statement, gives up {{ range $i, $f := . }}{{ if $i }}, {{ end }}{{ $f.Name }}{{ end }} (schema.GivenUpOnDiscard){{ end }}; a row of
// another Workspace, an already discarded row or one a predicate excludes is not found. A discarded
// row is never brought back (ADR 0100): the generated client has no Undiscard.
func (t *{{ $N }}Scoped) Discard(ctx context.Context, id int64, at time.Time, ps ...predicate.{{ $N }}) error {
	where := append([]predicate.{{ $N }}{ {{ $P }}.ID(id), {{ $P }}.WorkspaceID(t.s.ws), {{ $P }}.DiscardedAtIsNil()}, ps...)
	return t.s.write{{ $N }}(ctx, "{{ verb $n "discard" }}", where, false, func(s *Scoped) ([]int64, error) {
		_, err := s.c.{{ $N }}.UpdateOneID(id).Where(where...).SetDiscardedAt(at){{ range $f := discardClears $n }}.Set{{ $f.StructField }}(false){{ end }}.Save(ctx)
		return nil, err
	})
}
{{ end }}

