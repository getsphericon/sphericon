// {{ $N }}ScopedUpdate is a conditional bulk update of one Workspace: it keeps its predicates and
// what its setters and modifiers set, and builds the ent update on the client the update runs on.
type {{ $N }}ScopedUpdate struct {
	s     *Scoped
	where []predicate.{{ $N }}
	set   []func(*{{ $N }}Update)
	// modErr is set when a Modify modifier tried to assign workspace_id.
	modErr error
}

// Update updates the {{ $N }} entities of the Workspace that match the predicates.
func (t *{{ $N }}Scoped) Update() *{{ $N }}ScopedUpdate {
	return &{{ $N }}ScopedUpdate{s: t.s}
}

// Where appends predicates the rows must match.
func (x *{{ $N }}ScopedUpdate) Where(ps ...predicate.{{ $N }}) *{{ $N }}ScopedUpdate {
	x.where = append(x.where, ps...)
	return x
}

// Modify adds a statement modifier for computed assignments the typed setters cannot
// express (SET col = LEAST(col + ..., ...)). A modifier gets assignment-only access
// (ScopedAssign), so it cannot widen the Workspace predicate; an assignment to
// workspace_id is refused: each modifier is probed against a scratch statement here, and
// Save fails with ErrWorkspaceAssign.
func (x *{{ $N }}ScopedUpdate) Modify(modifiers ...func(a *ScopedAssign)) *{{ $N }}ScopedUpdate {
	for _, m := range modifiers {
		probe := &ScopedAssign{u: sql.Update({{ $P }}.Table)}
		m(probe)
		if probe.workspace {
			x.modErr = ErrWorkspaceAssign
		}
		x.set = append(x.set, func(b *{{ $N }}Update) {
			b.Modify(func(u *sql.UpdateBuilder) { m(&ScopedAssign{u: u}) })
		})
	}
	return x
}

{{ with extend $n "Node" $n "Builder" (print $N "ScopedUpdate") "Raw" (print $N "Update") "Mode" "update" }}
	{{ template "helper/scopedsetters" . }}
{{ end }}

// Save verifies the references against the Workspace, then updates the rows and
// returns how many changed.
func (x *{{ $N }}ScopedUpdate) Save(ctx context.Context) (int, error) {
	if x.modErr != nil {
		return 0, x.modErr
	}
	where := append([]predicate.{{ $N }}{ {{ $P }}.WorkspaceID(x.s.ws)}, x.where...)
	var n int
	err := x.s.write{{ $N }}(ctx, "{{ verb $n "update" }}", where, false, func(s *Scoped) ([]int64, error) {
		b := s.c.{{ $N }}.Update().Where(where...)
		for _, set := range x.set {
			set(b)
		}
		if err := s.check{{ $N }}(ctx, b.Mutation()); err != nil {
			return nil, err
		}
		var err error
		n, err = b.Save(ctx)
		return nil, err
	})
	if err != nil {
		return 0, err
	}
	return n, nil
}

// Exec is like Save, discarding the count.
func (x *{{ $N }}ScopedUpdate) Exec(ctx context.Context) error {
	_, err := x.Save(ctx)
	return err
}

const (
	TypeOf_{{ $N }}ScopedUpdate        = TypeScopedUpdate
	EntityOf_{{ $N }}ScopedUpdate      = "{{ $N }}"
	RoleOf_{{ $N }}ScopedUpdate_Where  = RoleStep
	RoleOf_{{ $N }}ScopedUpdate_Modify = RoleStep
	RoleOf_{{ $N }}ScopedUpdate_Save   = RoleStep
	RoleOf_{{ $N }}ScopedUpdate_Exec   = RoleStep
)
{{ end }}
{{ end }}


