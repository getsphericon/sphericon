// {{ $N }}ScopedUpdateOne updates one {{ $N }}. It has no way to move the row to another Workspace: it
// keeps the row's id, its fences and what its setters set, and builds the ent update on the client
// the update runs on.
type {{ $N }}ScopedUpdateOne struct {
	s     *Scoped
	id    int64
	where []predicate.{{ $N }}
	set   []func(*{{ $N }}UpdateOne)
}

// UpdateOneID updates the {{ $N }} with the id; a row of another Workspace is not found.
func (t *{{ $N }}Scoped) UpdateOneID(id int64) *{{ $N }}ScopedUpdateOne {
	return &{{ $N }}ScopedUpdateOne{s: t.s, id: id}
}

// Where appends predicates the row must also match (fencing).
func (x *{{ $N }}ScopedUpdateOne) Where(ps ...predicate.{{ $N }}) *{{ $N }}ScopedUpdateOne {
	x.where = append(x.where, ps...)
	return x
}

{{ with extend $n "Node" $n "Builder" (print $N "ScopedUpdateOne") "Raw" (print $N "UpdateOne") "Mode" "update" }}
	{{ template "helper/scopedsetters" . }}
{{ end }}

// Save verifies the references against the Workspace, then updates the {{ $N }}.
func (x *{{ $N }}ScopedUpdateOne) Save(ctx context.Context) (*{{ $N }}, error) {
	return x.save(ctx, "{{ verb $n "update" }}", false)
}

// save is Save under the verb of the write it is: a Versioned definition's pointers archive,
// unarchive or discard through it, and record their move even when no audited field changed
// (keepUnchanged).
func (x *{{ $N }}ScopedUpdateOne) save(ctx context.Context, verb string, keepUnchanged bool) (*{{ $N }}, error) {
	where := append([]predicate.{{ $N }}{ {{ $P }}.WorkspaceID(x.s.ws)}, x.where...)
	var updated *{{ $N }}
	err := x.s.write{{ $N }}(ctx, verb, append([]predicate.{{ $N }}{ {{ $P }}.ID(x.id)}, where...), keepUnchanged, func(s *Scoped) ([]int64, error) {
		b := s.c.{{ $N }}.UpdateOneID(x.id).Where(where...)
		for _, set := range x.set {
			set(b)
		}
		if err := s.check{{ $N }}(ctx, b.Mutation()); err != nil {
			return nil, err
		}
		var err error
		updated, err = b.Save(ctx)
		return nil, err
	})
	if err != nil {
		return nil, err
	}
	return updated, nil
}

// Exec is like Save, discarding the entity.
func (x *{{ $N }}ScopedUpdateOne) Exec(ctx context.Context) error {
	_, err := x.Save(ctx)
	return err
}

const (
	TypeOf_{{ $N }}ScopedUpdateOne       = TypeScopedUpdate
	EntityOf_{{ $N }}ScopedUpdateOne     = "{{ $N }}"
	RoleOf_{{ $N }}ScopedUpdateOne_Where = RoleStep
	RoleOf_{{ $N }}ScopedUpdateOne_Save  = RoleStep
	RoleOf_{{ $N }}ScopedUpdateOne_Exec  = RoleStep
)

