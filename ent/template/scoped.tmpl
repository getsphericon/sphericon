// {{ $N }}ScopedDelete deletes the {{ $N }} rows of one Workspace that match its predicates, which it
// keeps until the delete is built on the client it runs on.
type {{ $N }}ScopedDelete struct {
	s     *Scoped
	where []predicate.{{ $N }}
}

// {{ $Del }} {{ if $Aside }}physically removes{{ else }}deletes{{ end }} the {{ $N }} entities of the Workspace that match the predicates.
func (t *{{ $N }}Scoped) {{ $Del }}() *{{ $N }}ScopedDelete {
	return &{{ $N }}ScopedDelete{s: t.s}
}

// Where appends predicates the rows must match.
func (x *{{ $N }}ScopedDelete) Where(ps ...predicate.{{ $N }}) *{{ $N }}ScopedDelete {
	x.where = append(x.where, ps...)
	return x
}

const (
	TypeOf_{{ $N }}ScopedDelete      = TypeScopedDelete
	EntityOf_{{ $N }}ScopedDelete    = "{{ $N }}"
	RoleOf_{{ $N }}ScopedDelete_Where = RoleStep
	RoleOf_{{ $N }}ScopedDelete_Exec  = RoleStep
)

// Exec deletes the rows and returns how many were deleted.
func (x *{{ $N }}ScopedDelete) Exec(ctx context.Context) (int, error) {
	where := append([]predicate.{{ $N }}{ {{ $P }}.WorkspaceID(x.s.ws)}, x.where...)
	var n int
	err := x.s.write{{ $N }}(ctx, "{{ verb $n "delete" }}", where, false, func(s *Scoped) ([]int64, error) {
		var err error
		n, err = s.c.{{ $N }}.Delete().Where(where...).Exec(ctx)
		return nil, err
	})
	return n, err
}

