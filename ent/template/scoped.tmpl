// Save verifies the references against the Workspace, then updates the {{ $N }}.
func (x *{{ $N }}ScopedUpdateOne) Save(ctx context.Context) (*{{ $N }}, error) {
	if err := x.check(ctx); err != nil {
		return nil, err
	}
	{{- if $A }}
	if x.s.auditing() {
		var updated *{{ $N }}
		err := x.s.audited(ctx, func(ts *Scoped) error {
			id, _ := x.b.Mutation().ID()
			before, err := ts.c.{{ $N }}.Query().Where(x.b.mutation.predicates...).Where({{ $P }}.ID(id)).Only(ctx)
			if err != nil {
				return err
			}
			x.b.auditRebind(ts.c)
			if updated, err = x.b.Save(ctx); err != nil {
				return err
			}
			return ts.record(ctx, auditChange{{ $N }}("update", before, updated))
		})
		return updated, err
	}
	{{- end }}
	return x.b.Save(ctx)
}

// Exec is like Save, discarding the entity.
func (x *{{ $N }}ScopedUpdateOne) Exec(ctx context.Context) error {
	_, err := x.Save(ctx)
	return err
}

// {{ $N }}ScopedUpdate wraps {{ $N }}Update: a conditional bulk update of one Workspace.
type {{ $N }}ScopedUpdate struct {
	s *Scoped
	b *{{ $N }}Update
	// modErr is set when a Modify modifier tried to assign workspace_id.
	modErr error
}

// Update updates the {{ $N }} entities of the Workspace that match the predicates.
func (t *{{ $N }}Scoped) Update() *{{ $N }}ScopedUpdate {
	return &{{ $N }}ScopedUpdate{s: t.s, b: t.s.c.{{ $N }}.Update().Where({{ $P }}.WorkspaceID(t.s.ws))}
}

// Where appends predicates the rows must match.
func (x *{{ $N }}ScopedUpdate) Where(ps ...predicate.{{ $N }}) *{{ $N }}ScopedUpdate {
	x.b.Where(ps...)
	return x
}

// Modify adds a statement modifier for computed assignments the typed setters cannot
// express (SET col = LEAST(col + ..., ...)). A modifier gets assignment-only access
// (ScopedAssign), so it cannot widen the Workspace predicate; an assignment to
// workspace_id is refused: each modifier is probed against a scratch statement here, and
// Save fails with ErrWorkspaceAssign.
func (x *{{ $N }}ScopedUpdate) Modify(modifiers ...func(a *ScopedAssign)) *{{ $N }}ScopedUpdate {
	for _, m := range modifiers {
		probe := &ScopedAssign{u: sql.Update({{ $P }}.Table)}
		m(probe)
		if probe.workspace {
			x.modErr = ErrWorkspaceAssign
		}
		x.b.Modify(func(u *sql.UpdateBuilder) { m(&ScopedAssign{u: u}) })
	}
	return x
}

