	"time"

	"entgo.io/ent/dialect/sql"
	"{{ $.Config.Package }}/predicate"
	{{- range $n := scopedNodes $ }}
	"{{ $.Config.Package }}/{{ $n.Package }}"
	{{- end }}
)

var (
	_ = time.Time{}
	_ predicate.Contact
)

// ErrNotInWorkspace: a reference id set on a scoped builder belongs to another Workspace
// (or does not exist).
var ErrNotInWorkspace = errors.New("ent: referenced entity is not in the workspace")

// ErrWorkspaceAssign: a scoped update's Modify tried to assign workspace_id, which would
// move rows to another Workspace.
var ErrWorkspaceAssign = errors.New("ent: a scoped update cannot assign workspace_id")

// ScopedAssign is what Modify hands a modifier: assignments only (a computed value the
// typed setters cannot express, SET col = LEAST(col + ..., ...)), and never to
// workspace_id. It exposes no way to widen or drop the statement's Workspace predicate.
type ScopedAssign struct {
	u         *sql.UpdateBuilder
	workspace bool
}

// Set assigns a column. An assignment to workspace_id is refused (Save returns
// ErrWorkspaceAssign) and never reaches the statement.
func (a *ScopedAssign) Set(column string, v any) *ScopedAssign {
	if column == "workspace_id" {
		a.workspace = true
		return a
	}
	a.u.Set(column, v)
	return a
}

// Scoped is the entry point to every Workspace-owned entity, confined to one Workspace.
// Build it from a client or from a transaction's client: `tx.Client().Scoped(ws)`.
//
// A scope may carry the Actor of its writes (Scoped.As, scoped_audit.tmpl): writes of
// entities that opted into the Audit log are then recorded in their own transaction.
type Scoped struct {
	c      *Client
	ws     int64
	actor  Actor
	opener AuditOpener
	pub    AuditPublisher
}

// Scoped returns the client confined to the given Workspace.
func (c *Client) Scoped(ws int64) *Scoped { return &Scoped{c: c, ws: ws} }

// Atomic runs fn with the scope over one transaction: the scope's own when it was built from a
// transaction's client, else a new one, committed when fn returns nil and rolled back otherwise.
func (s *Scoped) Atomic(ctx context.Context, fn func(*Scoped) error) error {
	tx, err := s.c.Tx(ctx)
	if errors.Is(err, ErrTxStarted) {
		return fn(s)
	}
	if err != nil {
		return err
	}
	in := *s
	in.c = tx.Client()
	if err := fn(&in); err != nil {
		return errors.Join(err, tx.Rollback())
	}
	return tx.Commit()
}

// WorkspaceID returns the Workspace the client is confined to.
func (s *Scoped) WorkspaceID() int64 { return s.ws }

// Workspace loads the Workspace row the client is confined to. The Workspace is the
// tenant root, not a Workspace-owned entity, so it has no wrapper of its own: this
// read is the one way in (writes live in the accounts package).
func (s *Scoped) Workspace(ctx context.Context) (*Workspace, error) {
	return s.c.Workspace.Get(ctx, s.ws)
}

// uniqueIDs returns the sorted, de-duplicated ids.
func uniqueIDs(ids []int64) []int64 {
	s := slices.Clone(ids)
	slices.Sort(s)
	return slices.Compact(s)
}

{{ range $n := scopedNodes $ }}
// verify{{ $n.Name }} fails with ErrNotInWorkspace unless every id is a {{ $n.Name }} of the Workspace.
func (s *Scoped) verify{{ $n.Name }}(ctx context.Context, ids []int64) error {
	ids = uniqueIDs(ids)
	if len(ids) == 0 {
		return nil
	}
	n, err := s.c.{{ $n.Name }}.Query().Where({{ $n.Package }}.IDIn(ids...), {{ $n.Package }}.WorkspaceID(s.ws)).Count(ctx)
	if err != nil {
		return err
	}
	if n != len(ids) {
		return fmt.Errorf("{{ $n.Name }}: %w", ErrNotInWorkspace)
	}
	return nil
}
{{ end }}

