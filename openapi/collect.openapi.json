{
  "openapi": "3.0.0",
  "info": {
    "title": "Sphericon Collect API",
    "version": "1.0.0",
    "description": "Event ingestion for customer sites and apps, authenticated by a collect key."
  },
  "tags": [
    {
      "name": "Collect"
    }
  ],
  "paths": {
    "/events": {
      "post": {
        "operationId": "CollectEvents_create",
        "parameters": [],
        "responses": {
          "204": {
            "description": "There is no content to send for this request, but the headers may be useful."
          },
          "400": {
            "description": "RFC 7807 bad request response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "RFC 7807 payload too large response: the body exceeds the size cap (ADR 0025)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "RFC 7807 validation response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "RFC 7807 service unavailable response: the database cannot be reached. The request changed nothing; retry it after `Retry-After` seconds with the same `clientEventId`s.",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Collect"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectEventsInput"
              }
            }
          }
        }
      }
    },
    "/identify": {
      "post": {
        "operationId": "CollectIdentify_create",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectOkResponse"
                }
              }
            }
          },
          "400": {
            "description": "RFC 7807 bad request response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "RFC 7807 payload too large response: the body exceeds the size cap (ADR 0025)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "RFC 7807 validation response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "RFC 7807 service unavailable response: the database cannot be reached. The request changed nothing; retry it after `Retry-After` seconds with the same `clientEventId`s.",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Collect"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectIdentifyInput"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "schemas": {
      "CollectEventInput": {
        "type": "object",
        "required": ["visitorId", "action"],
        "properties": {
          "visitorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "clientEventId": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 255,
            "description": "A client-chosen id that makes a retry safe. It is unique within the Workspace: sending\nan event again with the same id changes nothing, so a client that did not see the answer\n(a network error, a `503`) resends the whole batch. Generate it once per event, when the\nevent happens (a UUID), and reuse it on every retry. An event without one is not deduplicated."
          },
          "properties": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonObject"
              }
            ],
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "nullable": true
          }
        }
      },
      "CollectEventsInput": {
        "type": "object",
        "required": ["events"],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectEventInput"
            },
            "maxItems": 100
          }
        }
      },
      "CollectIdentifyContext": {
        "type": "object",
        "properties": {
          "timeZone": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "The browser's IANA time zone"
          },
          "locale": {
            "type": "string",
            "nullable": true,
            "maxLength": 35,
            "description": "The browser's language, a BCP 47 tag"
          }
        },
        "description": "The browser's own settings, sent by the tracker with an identify"
      },
      "CollectIdentifyInput": {
        "type": "object",
        "required": ["visitorId"],
        "properties": {
          "visitorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/EmailAddress"
              }
            ],
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 32
          },
          "subjectId": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "traits": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonObject"
              }
            ],
            "nullable": true,
            "description": "Attributes of the contact; a trait named after a core attribute (`firstName`, `timeZone`,\n`country`, `locale`, `birthday`, `city`, `avatar`) writes it, null clears it, and an invalid\nvalue of one is dropped"
          },
          "context": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CollectIdentifyContext"
              }
            ],
            "nullable": true,
            "description": "What the browser tells of the visitor: it fills only a time zone or locale the contact has\nnone of"
          }
        }
      },
      "CollectOkResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [true]
          }
        }
      },
      "ConflictProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 conflict response"
      },
      "CountryCode": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "An ISO 3166-1 alpha-2 country code, upper case (`US`, `DE`)"
      },
      "EditorDocument": {
        "type": "object",
        "additionalProperties": {},
        "description": "The email editor's JSON document, an opaque object the server checks against the schema\n`email_schema` returns. One named model, as JsonObject."
      },
      "EmailAddress": {
        "type": "string",
        "maxLength": 320,
        "format": "email"
      },
      "EntityId": {
        "type": "string",
        "pattern": "^[0-9]{1,18}$",
        "format": "int64",
        "description": "A primary key, written as a decimal string so JavaScript never rounds it. The format\nmakes the Go servers parse it into an int64: a malformed id is refused as a 400 before\na handler runs. The pattern says the same in the contract, so a client (or a fuzzer) can\ntell a malformed id from a valid one without trying it. Eighteen digits is the most a key\nreaches, so every id the schema admits fits an int64."
      },
      "ForbiddenProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 forbidden response"
      },
      "GoneProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 gone response: the resource existed but is no longer available (an expired link)"
      },
      "ImageUrl": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^https://\\S+$",
        "description": "The https URL of an image"
      },
      "InUseProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/InUseProblemDetails"
          }
        },
        "description": "RFC 7807 conflict response for a removal refused because live work still uses the row\n(ADR 0049): 409 with `usedBy` naming the users. Every refused removal of a Segment, Tag,\nIntegration, Sending domain or Automation answers it."
      },
      "InUseProblemDetails": {
        "type": "object",
        "required": ["usedBy"],
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProblemCode"
              }
            ],
            "description": "Why the request was refused, when the client should act on it"
          },
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence"
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Validation errors grouped by field"
          },
          "form": {
            "type": "string",
            "description": "Form-level validation error"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Field validation errors"
          },
          "retryAfter": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds to wait before retrying; set on a 429 so a client that only sees the body can show the wait"
          },
          "debug": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProblemDebug"
              }
            ],
            "description": "Why a 500 happened, sent only by a development server (`SPHERICON_ENV=development`)"
          },
          "usedBy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsedBy"
            },
            "description": "The live rows that use the one a removal was refused for, never empty"
          }
        },
        "description": "The body of a refused removal (ADR 0049): ProblemDetails plus the rows that use it"
      },
      "JsonObject": {
        "type": "object",
        "additionalProperties": {},
        "description": "A JSON object whose members the contract leaves open: custom field values, event properties,\nintegration params, an audit diff. One named model, so every surface's Go code has one type for\nit rather than one per field."
      },
      "LocaleTag": {
        "type": "string",
        "maxLength": 35,
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
        "description": "A BCP 47 language tag: a language, optionally with a script and a region (`de`, `pt-BR`)"
      },
      "NotFoundProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 not found response"
      },
      "PaymentRequiredProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 payment required response: the feature needs an Enterprise license"
      },
      "PreconditionRequiredProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 precondition required response: the request needs something it did not carry\n(a verification link opened outside its Sign-up browser needs a password, ADR 0030)"
      },
      "ProblemCode": {
        "type": "string",
        "enum": [
          "second_factor_required",
          "email_verification_required",
          "permission_required",
          "migrations_pending",
          "acceptance_pending"
        ],
        "description": "A machine-readable reason a client branches on, beyond the HTTP status"
      },
      "ProblemDebug": {
        "type": "object",
        "required": ["error", "method", "path"],
        "properties": {
          "error": {
            "type": "string",
            "description": "The error that failed the request, or the panic value"
          },
          "stack": {
            "type": "string",
            "description": "The goroutine stack of a panic; absent for an error a handler returned"
          },
          "requestId": {
            "type": "string",
            "description": "The request id the server log carries for this request"
          },
          "method": {
            "type": "string",
            "description": "The HTTP method of the failed request"
          },
          "path": {
            "type": "string",
            "description": "The path of the failed request"
          }
        },
        "description": "What a development server adds to a 500 so the page can show the fault; a production\nInstance never sends it"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProblemCode"
              }
            ],
            "description": "Why the request was refused, when the client should act on it"
          },
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence"
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Validation errors grouped by field"
          },
          "form": {
            "type": "string",
            "description": "Form-level validation error"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Field validation errors"
          },
          "retryAfter": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds to wait before retrying; set on a 429 so a client that only sees the body can show the wait"
          },
          "debug": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProblemDebug"
              }
            ],
            "description": "Why a 500 happened, sent only by a development server (`SPHERICON_ENV=development`)"
          }
        },
        "description": "RFC 7807 Problem Details"
      },
      "TimeZoneName": {
        "type": "string"
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "UsedBy": {
        "type": "object",
        "required": ["kind", "id", "name"],
        "properties": {
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UsedByKind"
              }
            ],
            "description": "What kind of row it is"
          },
          "id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EntityId"
              }
            ],
            "description": "Its id"
          },
          "name": {
            "type": "string",
            "description": "Its name"
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "How many rows the entry stands for; absent means one. An `enrollment` entry names the\nAutomation (id, name) and counts its Enrollments; a `message` entry names it and counts its\nsent Outbound messages."
          }
        },
        "description": "A row that uses the one a removal was refused for: what a client shows to say what to\nchange first"
      },
      "UsedByKind": {
        "type": "string",
        "enum": ["broadcast", "automation", "segment", "rule", "enrollment", "firing", "message"],
        "description": "What kind of row a refused removal names as a user of the row (ADR 0049). One value per kind\nof live user a removal can find, so a client branches on it without parsing text."
      },
      "WorkspaceId": {
        "type": "string",
        "pattern": "^[0-9A-Za-z]{8}$",
        "description": "A Workspace id (ADR 0043): 8 random base62 characters, assigned once at creation and the\nWorkspace's one public address."
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-collect-key"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/collect",
      "description": "Local development collect API",
      "variables": {}
    }
  ]
}
