{
  "openapi": "3.0.0",
  "info": {
    "title": "Sphericon Service API",
    "version": "1.0.0",
    "description": "The Operator surface a service calls with a Service credential (ADR 0026). It is served only by the internal listener, never on the public port."
  },
  "tags": [
    {
      "name": "Service Identity"
    },
    {
      "name": "Service Holds"
    }
  ],
  "paths": {
    "/identity": {
      "get": {
        "operationId": "ServiceIdentity_get",
        "description": "The calling credential's own name, scopes and expiry. Any valid credential may read it.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceIdentityResource"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Identity"]
      }
    },
    "/workspaces/{workspaceId}/holds": {
      "get": {
        "operationId": "ServiceHolds_list",
        "description": "The holds of a Workspace that are active now; a lapsed one is not listed",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldList"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "RFC 7807 not found response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Holds"]
      }
    },
    "/workspaces/{workspaceId}/holds/{key}": {
      "put": {
        "operationId": "ServiceHolds_set",
        "description": "Set a hold under a key, or renew it by setting it again with a later expiry.\nIdempotent: setting the same hold twice changes nothing.",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResource"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "RFC 7807 not found response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "RFC 7807 validation response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Holds"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldInput"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "ServiceHolds_clear",
        "description": "Clear a hold by its key. Idempotent: clearing a missing hold succeeds.",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "There is no content to send for this request, but the headers may be useful."
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "RFC 7807 not found response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Holds"]
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "BadRequestProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 bad request response"
      },
      "ConflictProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 conflict response"
      },
      "EmailAddress": {
        "type": "string",
        "format": "email"
      },
      "EntityId": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "ForbiddenProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 forbidden response"
      },
      "GoneProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 gone response: the resource existed but is no longer available (an expired link)"
      },
      "HoldInput": {
        "type": "object",
        "required": ["reasonCode", "message", "expiresAt"],
        "properties": {
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$",
            "description": "A machine code for the reason: lowercase letters, digits and underscores"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The message shown to the Workspace Owner, as given"
          },
          "expiresAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Required; in the future and no further than the configured maximum from now"
          }
        },
        "description": "Setting or renewing a hold"
      },
      "HoldList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HoldResource"
            }
          }
        },
        "description": "The active holds of a Workspace"
      },
      "HoldResource": {
        "type": "object",
        "required": [
          "key",
          "reasonCode",
          "message",
          "expiresAt",
          "setBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "The key the setter chose; unique per Workspace"
          },
          "reasonCode": {
            "type": "string",
            "description": "A machine code for the reason"
          },
          "message": {
            "type": "string",
            "description": "The message shown to the Workspace Owner, as given"
          },
          "expiresAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the hold stops freezing sending unless its setter renews it"
          },
          "setBy": {
            "type": "string",
            "description": "The name of the Service credential that last set it"
          },
          "createdAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the hold was first set"
          },
          "updatedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the hold was last set or renewed"
          }
        },
        "description": "An Operator hold: one reversible freeze of a Workspace's outbound sending (ADR 0009)"
      },
      "PaymentRequiredProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 payment required response: the feature needs an Enterprise license"
      },
      "ProblemCode": {
        "type": "string",
        "enum": ["second_factor_required"],
        "description": "A machine-readable reason a client branches on, beyond the HTTP status"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProblemCode"
              }
            ],
            "description": "Why the request was refused, when the client should act on it"
          },
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence"
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Validation errors grouped by field"
          },
          "form": {
            "type": "string",
            "description": "Form-level validation error"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Field validation errors"
          },
          "retryAfter": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds to wait before retrying; set on a 429 so a client that only sees the body can show the wait"
          }
        },
        "description": "RFC 7807 Problem Details"
      },
      "ServiceIdentityResource": {
        "type": "object",
        "required": ["name", "scopes"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The service's name, as recorded in the Audit log"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceScope"
            },
            "description": "The scopes the credential carries"
          },
          "expiresAt": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "nullable": true,
            "description": "When the credential stops working; absent when it never expires"
          }
        },
        "description": "What a Service credential is: its name, its scopes and its expiry"
      },
      "ServiceScope": {
        "type": "string",
        "enum": ["usage:read", "workspaces:read", "holds:write"],
        "description": "A scope a Service credential may carry"
      },
      "TimeZoneName": {
        "type": "string"
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3400/service",
      "description": "Internal listener",
      "variables": {}
    }
  ]
}
