{
  "openapi": "3.0.0",
  "info": {
    "title": "Sphericon Service API",
    "version": "1.0.0",
    "description": "The Operator surface a service calls with a Service credential (ADR 0026). It is served only by the internal listener, never on the public port."
  },
  "tags": [
    {
      "name": "Service Identity"
    },
    {
      "name": "Service Holds"
    },
    {
      "name": "Service Usage"
    },
    {
      "name": "Service Workspaces"
    }
  ],
  "paths": {
    "/identity": {
      "get": {
        "operationId": "ServiceIdentity_get",
        "description": "The calling credential's own name, scopes and expiry. Any valid credential may read it.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceIdentityResource"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Identity"]
      }
    },
    "/usage": {
      "get": {
        "operationId": "ServiceUsage_list",
        "description": "The figures of every Workspace for a Usage period, by Workspace id: Live usage for\nthe open period, Usage snapshots for a closed one. Never a recount on read.",
        "parameters": [
          {
            "$ref": "#/components/parameters/UsagePeriodQuery"
          },
          {
            "$ref": "#/components/parameters/PageQuery.page"
          },
          {
            "$ref": "#/components/parameters/PageQuery.pageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "page", "pageSize", "totalItems", "totalPages"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WorkspaceUsageResource"
                      },
                      "description": "List of items"
                    },
                    "page": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Page number (1-based)"
                    },
                    "pageSize": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Page size"
                    },
                    "totalItems": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Total number of elements"
                    },
                    "totalPages": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Total number of pages"
                    }
                  },
                  "description": "Paginated response"
                }
              }
            }
          },
          "400": {
            "description": "RFC 7807 bad request response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "RFC 7807 forbidden response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Usage"]
      }
    },
    "/workspaces/changes": {
      "get": {
        "operationId": "ServiceWorkspaceFeed_list",
        "description": "The Workspaces created or changed since an opaque cursor, each with all of its\nowners, in a stable order by change position. A change is a new Workspace, an owner\nadded, removed or transferred, or an owner's email or verification changing.\nDelivery is at-least-once: replaying a cursor returns the same entries, and an\nempty cursor starts from the beginning. Needs the `workspaces:read` scope.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The `nextCursor` of a page the caller has saved; empty starts from the beginning",
            "schema": {
              "type": "string"
            },
            "explode": false
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Most entries on the page",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 200
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceWorkspaceFeedPage"
                }
              }
            }
          },
          "400": {
            "description": "RFC 7807 bad request response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "RFC 7807 forbidden response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Workspaces"]
      }
    },
