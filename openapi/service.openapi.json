    "/workspaces/{workspaceId}/usage": {
      "get": {
        "operationId": "ServiceWorkspaceUsage_get",
        "description": "The figures of one Workspace for a Usage period: Live usage (not final, counting\nsends still in flight) for the open period, Usage snapshots (final) for a closed one.\nNever a recount on read.",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          },
          {
            "$ref": "#/components/parameters/UsagePeriodQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceUsageResource"
                }
              }
            }
          },
          "400": {
            "description": "RFC 7807 bad request response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "RFC 7807 unauthorized response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "RFC 7807 forbidden response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "RFC 7807 not found response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RFC 7807 too many requests response: a rate limit was exceeded (ADR 0025)",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Limit": {
                "required": true,
                "description": "The request budget of the window that was exceeded",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Remaining": {
                "required": true,
                "description": "Requests left in the current window",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-RateLimit-Reset": {
                "required": true,
                "description": "Unix time at which the window resets",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": ["Service Usage"]
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "parameters": {
      "PageQuery.page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number (1-based)",
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 1
        },
        "explode": false
      },
      "PageQuery.pageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Page size",
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 25
        },
        "explode": false
      },
      "UsagePeriodQuery": {
        "name": "period",
        "in": "query",
        "required": false,
        "description": "The Usage period as YYYY-MM (UTC); the current one when absent",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "explode": false
      }
    },
    "schemas": {
      "ConflictProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 conflict response"
      },
      "EmailAddress": {
        "type": "string",
        "format": "email"
      },
      "EntityId": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "GoneProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 gone response: the resource existed but is no longer available (an expired link)"
      },
      "HoldClearResult": {
        "type": "object",
        "required": ["changed"],
        "properties": {
          "changed": {
            "type": "boolean",
            "description": "False when no such hold was set and nothing changed, so a retry is visibly harmless"
          }
        },
        "description": "The outcome of clearing a hold"
      },
      "HoldInput": {
        "type": "object",
        "required": ["reasonCode", "message", "expiresAt"],
        "properties": {
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$",
            "description": "A machine code for the reason: lowercase letters, digits and underscores"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The message shown to the Workspace Owner, as given"
          },
          "expiresAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "Required; in the future and no further than the configured maximum from now"
          }
        },
        "description": "Setting or renewing a hold"
      },
      "HoldList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HoldResource"
            }
          }
        },
        "description": "The active holds of a Workspace"
      },
      "HoldResource": {
        "type": "object",
        "required": [
          "key",
          "reasonCode",
          "message",
          "expiresAt",
          "setBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "The key the setter chose; unique per Workspace"
          },
          "reasonCode": {
            "type": "string",
            "description": "A machine code for the reason"
          },
          "message": {
            "type": "string",
            "description": "The message shown to the Workspace Owner, as given"
          },
          "expiresAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the hold stops freezing sending unless its setter renews it"
          },
          "setBy": {
            "type": "string",
            "description": "The name of the Service credential that last set it"
          },
          "createdAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the hold was first set"
          },
          "updatedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the hold was last set or renewed"
          }
        },
        "description": "An Operator hold: one reversible freeze of a Workspace's outbound sending (ADR 0009)"
      },
      "HoldSetResult": {
        "type": "object",
        "required": ["changed", "hold"],
        "properties": {
          "changed": {
            "type": "boolean",
            "description": "False when the hold was already set exactly so and nothing changed, so a retry is visibly harmless"
          },
          "hold": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HoldResource"
              }
            ],
            "description": "The hold as it is stored now"
          }
        },
        "description": "The outcome of setting a hold"
      },
      "PaymentRequiredProblem": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "$ref": "#/components/schemas/ProblemDetails"
          }
        },
        "description": "RFC 7807 payment required response: the feature needs an Enterprise license"
      },
      "ProblemCode": {
        "type": "string",
        "enum": ["second_factor_required", "email_verification_required"],
        "description": "A machine-readable reason a client branches on, beyond the HTTP status"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProblemCode"
              }
            ],
            "description": "Why the request was refused, when the client should act on it"
          },
          "type": {
            "type": "string",
            "description": "A URI reference that identifies the problem type"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence"
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Validation errors grouped by field"
          },
          "form": {
            "type": "string",
            "description": "Form-level validation error"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Field validation errors"
          },
          "retryAfter": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds to wait before retrying; set on a 429 so a client that only sees the body can show the wait"
          }
        },
        "description": "RFC 7807 Problem Details"
      },
      "ServiceIdentityResource": {
        "type": "object",
        "required": ["name", "scopes"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The service's name, as recorded in the Audit log"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceScope"
            },
            "description": "The scopes the credential carries"
          },
          "expiresAt": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "nullable": true,
            "description": "When the credential stops working; absent when it never expires"
          }
        },
        "description": "What a Service credential is: its name, its scopes and its expiry"
      },
      "ServiceScope": {
        "type": "string",
        "enum": ["usage:read", "workspaces:read", "holds:write"],
        "description": "A scope a Service credential may carry"
      },
      "ServiceWorkspaceFeedPage": {
        "type": "object",
        "required": ["items", "nextCursor", "hasMore"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceWorkspaceResource"
            },
            "description": "Workspaces created or changed after the requested cursor, in change order"
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass it back as the cursor to read what follows this page. It is the requested\ncursor itself when the page is empty. Saving it is what advances the caller: the\ncore keeps no position of its own."
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether more entries follow this page right now"
          }
        },
        "description": "One page of the Workspace feed"
      },
      "ServiceWorkspaceOwner": {
        "type": "object",
        "required": ["userId", "email"],
        "properties": {
          "userId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EntityId"
              }
            ],
            "description": "The owner's User id"
          },
          "email": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EmailAddress"
              }
            ],
            "description": "The owner's current email"
          },
          "emailVerifiedAt": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "nullable": true,
            "description": "When the owner confirmed their email; absent while it is unverified"
          }
        },
        "description": "One owner of a Workspace in the feed"
      },
      "ServiceWorkspaceResource": {
        "type": "object",
        "required": ["id", "slug", "name", "createdAt", "owners"],
        "properties": {
          "id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EntityId"
              }
            ],
            "description": "Unique identifier"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the Workspace was created"
          },
          "owners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceWorkspaceOwner"
            },
            "description": "Every owner of the Workspace as of this entry"
          }
        },
        "description": "A Workspace with all of its owners, as the feed reports it"
      },
      "TimeZoneName": {
        "type": "string"
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "UsageFigure": {
        "type": "object",
        "required": ["metric", "value", "final", "computedAt"],
        "properties": {
          "metric": {
            "$ref": "#/components/schemas/UsageMetric"
          },
          "value": {
            "type": "integer",
            "format": "int64",
            "description": "The value of the metric over the period"
          },
          "final": {
            "type": "boolean",
            "description": "True once the Usage period closed: the figure is a Usage snapshot and never changes.\nFalse while it is Live usage."
          },
          "computedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              }
            ],
            "description": "When the figure was last computed"
          }
        },
        "description": "One metric's figure for a Workspace over a Usage period"
      },
      "UsageMetric": {
        "type": "string",
        "enum": ["emails_sent", "contacts"],
        "description": "A metric of Usage"
      },
      "WorkspaceUsageResource": {
        "type": "object",
        "required": ["workspaceId", "period", "figures"],
        "properties": {
          "workspaceId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EntityId"
              }
            ],
            "description": "The Workspace"
          },
          "period": {
            "type": "string",
            "description": "The Usage period: the calendar month in UTC, as YYYY-MM"
          },
          "figures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageFigure"
            },
            "description": "One figure per metric"
          }
        },
        "description": "The figures of one Workspace for one Usage period"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3400/service",
      "description": "Internal listener",
      "variables": {}
    }
  ]
}
