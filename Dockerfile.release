# Scratch runtime image used by GoReleaser (dockers_v2). GoReleaser builds the
# binaries on the host (frontend + Go, embed_spa) and lays them out per platform
# under $TARGETPLATFORM, so here we only wrap the prebuilt binary. For building
# straight from source, use the top-level Dockerfile instead.
# The runtime files scratch lacks.
FROM alpine:3.24@sha256:71e9b7bae160ba167fa17414401b94cbcdaf3c32feeab9298bd794a2a0614c35 AS rootfs
RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /rootfs/etc/ssl/certs /rootfs/usr/share \
    && cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ \
    && cp -R /usr/share/zoneinfo /rootfs/usr/share/ \
    && mkdir -m 1777 /rootfs/tmp

# scratch: no shell and no package manager, only the static binary (CGO_ENABLED=0 in
# .goreleaser.yaml), the CA roots for outbound TLS, the zoneinfo a TZ setting reads and an empty /tmp.
FROM scratch
COPY --from=rootfs /rootfs/ /
ARG TARGETPLATFORM
COPY --chmod=755 $TARGETPLATFORM/sphericon /usr/local/bin/sphericon
# Run unprivileged from an empty directory, never as root in /.
WORKDIR /app
USER 10001:10001
# Containers are production deployments: enforce the strict secret checks by default.
ENV SPHERICON_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["sphericon", "healthcheck"]
ENTRYPOINT ["sphericon"]
