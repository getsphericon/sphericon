{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "existingSecret": {
      "type": "string",
      "description": "Existing Secret with DATABASE_URL, SPHERICON_JWT_SECRET and SPHERICON_ENCRYPTION_KEY, as environment variables (required unless secretFiles.secretName is set)"
    },
    "secretFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "description": "Existing Secret mounted at /run/secrets/sphericon, read through the <KEY>_FILE variables"
        },
        "keys": {
          "type": "array",
          "items": {
            "enum": [
              "DATABASE_URL",
              "SPHERICON_JWT_SECRET",
              "SPHERICON_ENCRYPTION_KEY",
              "SPHERICON_SMTP_PASS",
              "SPHERICON_LICENSE_KEY"
            ]
          },
          "uniqueItems": true,
          "description": "The Secret's keys to expose as <KEY>_FILE"
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" },
            "runbookUrl": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" }
      }
    }
  }
}
