DATABASE_URL="postgres://postgres:postgres@localhost:5432/sphericon_development"
PORT=3300
HOST=0.0.0.0
JWT_SECRET=dev-secret-change-in-production
APP_URL=http://localhost:3300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@getsphericon.app

# Instance locale (en|ru|es). A SaaS deployment runs per country; this fixes the
# language of the SPA and of the backend's own emails + validation messages.
# Anything unsupported falls back to en. Default: en.
APP_LOCALE=en


# Base64-encoded Tink keyset for encrypting stored provider credentials
# (AES-256-GCM, rotation-ready). Generate one with: mise run gen:encryption-key
ENCRYPTION_KEY=

# Postgres connection pools (per replica). The defaults assume at most two
# replicas against max_connections=100: (15+25) x 2 x 1.15 = 92 <= 97.
# DB_MAX_OPEN_CONNS=15
# DB_MAX_IDLE_CONNS=15        # defaults to DB_MAX_OPEN_CONNS
# DB_CONN_MAX_LIFETIME=30m
# PGX_MAX_CONNS=25            # river pool; must cover river's MaxWorkers sum plus LISTEN

# Prometheus pull: set METRICS_ADDR (host:port, must differ from PORT) to serve
# /metrics on a dedicated internal listener. Empty = off; the public port never
# serves /metrics. Bind to 127.0.0.1 or restrict the port at the network level (ADR 0018).
# METRICS_ADDR=127.0.0.1:9090
# OpenTelemetry: set an OTLP endpoint to push traces + metrics to a collector
# (leave unset in prod self-hosted).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
