{
  "name": "@sphericon/emaildoc",
  "version": "0.0.0",
  "private": true,
  "description": "Builds the email document renderer bundle that the Go binary runs in an embedded JavaScript runtime",
  "type": "module",
  "imports": {
    "#compose-react-email": {
      "types": "./src/compose-react-email.d.ts",
      "default": "@react-email/editor/core"
    },
    "#editor-image-extension": {
      "types": "./src/editor-image-extension.d.ts"
    }
  },
  "scripts": {
    "build": "node build.ts"
  },
  "dependencies": {
    "@react-email/editor": "1.8.4",
    "@tiptap/core": "3.33.0",
    "esbuild": "0.28.2",
    "js-base64": "3.9.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-streams-polyfill": "4.5.1"
  }
}
